  %alias.030 = phi i1 [ false, %entry ], [ %alias.3, %for.end4 ]
  %Phi1825 = phi i32 [ 0, %entry ], [ %Phi8.lcssa, %for.end4 ]
  %Phi24 = phi i32 [ 0, %entry ], [ %add21, %for.end4 ]
  %neg.alias28 = icmp eq i1 %alias.030, false
  %6 = load i32* %3
  %.alloca.033. = select i1 %neg.alias28, i32 %.alloca.033, i32 %6
  %alias.030. = select i1 %neg.alias28, i1 %alias.030, i1 false
