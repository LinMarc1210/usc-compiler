; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  switch i32 1, label %switch.default [
    i32 1, label %switch.case
    i32 2, label %switch.case1
  ]

switch.end:                                       ; preds = %switch.default, %switch.case1
  %Phi2 = phi i32 [ 99, %switch.default ], [ %add, %switch.case1 ]
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %Phi2)
  ret i32 0

switch.case:                                      ; preds = %entry
  br label %switch.case1

switch.case1:                                     ; preds = %switch.case, %entry
  %Phi = phi i32 [ 10, %switch.case ], [ 0, %entry ]
  %add = add i32 %Phi, 5
  br label %switch.end

switch.default:                                   ; preds = %entry
  br label %switch.end
}
