; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [2 x i32], align 8
  %0 = getelementptr inbounds [2 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 7, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 0
  %4 = load i32* %3
  %5 = getelementptr inbounds i32* %0, i32 0
  %6 = load i32* %5
  %mul = mul i32 %6, 2
  %7 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %3, %7
  %alias.cmp21 = icmp eq i32* %5, %7
  br label %alias.header16

alias.header16:                                   ; preds = %entry, %if.end
  %mul.alloca.0 = phi i32 [ %mul, %entry ], [ %mul.alloca.1, %if.end ]
  %alias18.0 = phi i1 [ false, %entry ], [ %alias18.2, %if.end ]
  %.alloca.0 = phi i32 [ %4, %entry ], [ %.alloca.0., %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi315 = phi i32 [ 1, %entry ], [ %add4, %if.end ]
  %Phi214 = phi i32 [ 0, %entry ], [ %add, %if.end ]
  %Phi13 = phi i32 [ 0, %entry ], [ %add8, %if.end ]
  %neg.alias20 = icmp eq i1 %alias18.0, false
  br i1 %neg.alias20, label %alias.header, label %alias.fixup17

alias.fixup17:                                    ; preds = %alias.header16
  %8 = load i32* %5
  %9 = mul i32 %8, 2
  br label %alias.header

alias.header:                                     ; preds = %alias.header16, %alias.fixup17
  %mul.alloca.1 = phi i32 [ %mul.alloca.0, %alias.header16 ], [ %9, %alias.fixup17 ]
  %alias18.1 = phi i1 [ %alias18.0, %alias.header16 ], [ false, %alias.fixup17 ]
  %neg.alias = icmp eq i1 %alias.0, false
  %10 = load i32* %3
  %.alloca.0. = select i1 %neg.alias, i32 %.alloca.0, i32 %10
  %alias.0. = select i1 %neg.alias, i1 %alias.0, i1 false
  %add = add i32 %Phi214, %.alloca.0.
  %add4 = add i32 %Phi315, %mul.alloca.1
  %div = sdiv i32 %Phi13, 8
  %mul5 = mul i32 %div, 8
  %sub = sub i32 %Phi13, %mul5
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

for.end:                                          ; preds = %if.end
  %Phi3.lcssa = phi i32 [ %add4, %if.end ]
  %Phi2.lcssa = phi i32 [ %add, %if.end ]
  %11 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %add12 = add i32 %Phi2.lcssa, %Phi3.lcssa
  %12 = call i32 (i8*, ...)* @printf(i8* %11, i32 %add12)
  ret i32 0

if.then:                                          ; preds = %alias.header
  %add6 = add i32 %Phi13, 3
  store i32 %add6, i32* %7
  br label %if.end

if.end:                                           ; preds = %if.then, %alias.header
  %alias18.2 = phi i1 [ %alias.cmp21, %if.then ], [ %alias18.1, %alias.header ]
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.0., %alias.header ]
  %add8 = add i32 %Phi13, 1
  %lt = icmp slt i32 %add8, 16
  br i1 %lt, label %alias.header16, label %for.end, !prof !1
}

!0 = metadata !{metadata !"branch_weights", i32 2, i32 14}
!1 = metadata !{metadata !"branch_weights", i32 16, i32 1}
