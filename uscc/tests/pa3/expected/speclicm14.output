; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [2 x i32], align 8
  %0 = getelementptr inbounds [2 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 2, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 0
  %4 = load i32* %3
  %5 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %3, %5
  br label %alias.header

alias.header:                                     ; preds = %if.end, %entry
  %.alloca.0 = phi i32 [ %4, %entry ], [ %.alloca.0., %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi1832 = phi i32 [ 0, %entry ], [ %Phi14.lcssa, %if.end ]
  %Phi31 = phi i32 [ 0, %entry ], [ %add24, %if.end ]
  %neg.alias = icmp eq i1 %alias.0, false
  %6 = load i32* %3
  %.alloca.0. = select i1 %neg.alias, i32 %.alloca.0, i32 %6
  %alias.0. = select i1 %neg.alias, i1 %alias.0, i1 false
  br label %while.body4

while.end:                                        ; preds = %if.end
  %Phi18.lcssa = phi i32 [ %Phi14.lcssa, %if.end ]
  %7 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %8 = call i32 (i8*, ...)* @printf(i8* %7, i32 %Phi18.lcssa)
  ret i32 0

while.body4:                                      ; preds = %alias.header, %while.end10
  %Phi1430 = phi i32 [ %Phi1832, %alias.header ], [ %Phi12.lcssa, %while.end10 ]
  %Phi229 = phi i32 [ 0, %alias.header ], [ %add17, %while.end10 ]
  br label %while.body9

while.end5:                                       ; preds = %while.end10
  %Phi14.lcssa = phi i32 [ %Phi12.lcssa, %while.end10 ]
  %div = sdiv i32 %Phi31, 2
  %mul = mul i32 %div, 2
  %sub = sub i32 %Phi31, %mul
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

while.body9:                                      ; preds = %while.body4, %while.body9
  %Phi1228 = phi i32 [ %Phi1430, %while.body4 ], [ %add, %while.body9 ]
  %Phi727 = phi i32 [ 0, %while.body4 ], [ %add13, %while.body9 ]
  %add = add i32 %Phi1228, %.alloca.0.
  %add13 = add i32 %Phi727, 1
  %lt8 = icmp slt i32 %add13, 5
  br i1 %lt8, label %while.body9, label %while.end10, !prof !1

while.end10:                                      ; preds = %while.body9
  %Phi12.lcssa = phi i32 [ %add, %while.body9 ]
  %add17 = add i32 %Phi229, 1
  %lt3 = icmp slt i32 %add17, 4
  br i1 %lt3, label %while.body4, label %while.end5, !prof !2

if.then:                                          ; preds = %while.end5
  %add22 = add i32 %Phi31, 3
  store i32 %add22, i32* %5
  br label %if.end

if.end:                                           ; preds = %if.then, %while.end5
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.0., %while.end5 ]
  %add24 = add i32 %Phi31, 1
  %lt = icmp slt i32 %add24, 3
  br i1 %lt, label %alias.header, label %while.end, !prof !3
}

!0 = metadata !{metadata !"branch_weights", i32 2, i32 1}
!1 = metadata !{metadata !"branch_weights", i32 60, i32 12}
!2 = metadata !{metadata !"branch_weights", i32 12, i32 3}
!3 = metadata !{metadata !"branch_weights", i32 3, i32 1}
