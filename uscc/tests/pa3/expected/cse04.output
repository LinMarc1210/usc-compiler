; ModuleID = 'main'

@.str = private unnamed_addr constant [8 x i8] c"sum=%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %temp1.addr = alloca i32
  %sum.addr = alloca i32
  %i.addr = alloca i32
  %temp2.addr = alloca i32
  %b.addr = alloca i32
  %a.addr = alloca i32
  store i32 7, i32* %a.addr
  store i32 3, i32* %b.addr
  store i32 0, i32* %sum.addr
  store i32 0, i32* %i.addr
  %b = load i32* %b.addr
  %a = load i32* %a.addr
  %mul = mul i32 %a, %b
  store i32 %mul, i32* %temp1.addr
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %i = load i32* %i.addr
  %lt = icmp slt i32 %i, 10
  br i1 %lt, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  %b1 = load i32* %b.addr
  %a2 = load i32* %a.addr
  %mul3 = mul i32 %a2, %b1
  store i32 %mul3, i32* %temp2.addr
  %temp2 = load i32* %temp2.addr
  %sum = load i32* %sum.addr
  %add = add i32 %sum, %temp2
  store i32 %add, i32* %sum.addr
  %i4 = load i32* %i.addr
  %add5 = add i32 %i4, 1
  store i32 %add5, i32* %i.addr
  br label %while.cond

while.end:                                        ; preds = %while.cond
  %sum6 = load i32* %sum.addr
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([8 x i8]* @.str, i32 0, i32 0), i32 %sum6)
  ret i32 0
}
