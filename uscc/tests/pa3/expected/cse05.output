; ModuleID = 'main'

@.str = private unnamed_addr constant [6 x i8] c"y=%d\0A\00"
@.str1 = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %y.addr = alloca i32
  %x.addr = alloca i32
  %b.addr = alloca i32
  %a.addr = alloca i32
  store i32 1, i32* %a.addr
  store i32 2, i32* %b.addr
  %b = load i32* %b.addr
  %a = load i32* %a.addr
  %add = add i32 %a, %b
  store i32 %add, i32* %x.addr
  %x = load i32* %x.addr
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([4 x i8]* @.str1, i32 0, i32 0), i32 %x)
  store i32 5, i32* %a.addr
  %b1 = load i32* %b.addr
  %a2 = load i32* %a.addr
  %add3 = add i32 %a2, %b1
  store i32 %add3, i32* %y.addr
  %y = load i32* %y.addr
  %1 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([6 x i8]* @.str, i32 0, i32 0), i32 %y)
  ret i32 0
}
