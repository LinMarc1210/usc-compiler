; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [8 x i32], align 8
  %0 = getelementptr inbounds [8 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 0, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 2
  store i32 0, i32* %3
  %4 = getelementptr inbounds i32* %0, i32 3
  store i32 0, i32* %4
  %5 = getelementptr inbounds i32* %0, i32 4
  store i32 0, i32* %5
  %6 = getelementptr inbounds i32* %0, i32 5
  store i32 0, i32* %6
  %7 = getelementptr inbounds i32* %0, i32 6
  store i32 0, i32* %7
  %8 = getelementptr inbounds i32* %0, i32 7
  store i32 9, i32* %8
  %9 = getelementptr inbounds i32* %0, i32 7
  %10 = load i32* %9
  %11 = getelementptr inbounds i32* %0, i32 3
  %alias.cmp = icmp eq i32* %9, %11
  br label %alias.header

alias.header:                                     ; preds = %if.end, %entry
  %.alloca.0 = phi i32 [ %10, %entry ], [ %.alloca.1, %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi28 = phi i32 [ 0, %entry ], [ %add, %if.end ]
  %Phi7 = phi i32 [ 0, %entry ], [ %add4, %if.end ]
  %neg.alias = icmp eq i1 %alias.0, false
  br i1 %neg.alias, label %while.body, label %alias.fixup

alias.fixup:                                      ; preds = %alias.header
  %12 = load i32* %9
  br label %while.body

while.body:                                       ; preds = %alias.header, %alias.fixup
  %.alloca.1 = phi i32 [ %.alloca.0, %alias.header ], [ %12, %alias.fixup ]
  %alias.1 = phi i1 [ %alias.0, %alias.header ], [ false, %alias.fixup ]
  %add = add i32 %Phi28, %.alloca.1
  %div = sdiv i32 %Phi7, 16
  %mul = mul i32 %div, 16
  %sub = sub i32 %Phi7, %mul
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

while.end:                                        ; preds = %if.end
  %Phi2.lcssa = phi i32 [ %add, %if.end ]
  %13 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %14 = call i32 (i8*, ...)* @printf(i8* %13, i32 %Phi2.lcssa)
  ret i32 0

if.then:                                          ; preds = %while.body
  store i32 %Phi7, i32* %11
  br label %if.end

if.end:                                           ; preds = %if.then, %while.body
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.1, %while.body ]
  %add4 = add i32 %Phi7, 1
  %lt = icmp slt i32 %add4, 32
  br i1 %lt, label %alias.header, label %while.end, !prof !1
}

!0 = metadata !{metadata !"branch_weights", i32 2, i32 30}
!1 = metadata !{metadata !"branch_weights", i32 32, i32 1}
