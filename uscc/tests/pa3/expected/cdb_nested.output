; ModuleID = 'cdb_nested.ll'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  br label %a.then

a.then:                                           ; preds = %entry
  br label %b.else

b.else:                                           ; preds = %a.then
  br label %exit

exit:                                             ; preds = %b.else
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([4 x i8]* @.str, i32 0, i32 0), i32 3)
  ret i32 0
}
