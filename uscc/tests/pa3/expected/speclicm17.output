; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [2 x i32], align 8
  %0 = getelementptr inbounds [2 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 6, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 0
  %4 = load i32* %3
  %5 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %3, %5
  br label %alias.header

alias.header:                                     ; preds = %if.end, %entry
  %.alloca.0 = phi i32 [ %4, %entry ], [ %.alloca.0., %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi1021 = phi i32 [ 0, %entry ], [ %Phi8.lcssa, %if.end ]
  %Phi20 = phi i32 [ 0, %entry ], [ %add15, %if.end ]
  %neg.alias = icmp eq i1 %alias.0, false
  %6 = load i32* %3
  %.alloca.0. = select i1 %neg.alias, i32 %.alloca.0, i32 %6
  %alias.0. = select i1 %neg.alias, i1 %alias.0, i1 false
  br label %for.body2

for.end:                                          ; preds = %if.end
  %Phi10.lcssa = phi i32 [ %Phi8.lcssa, %if.end ]
  %7 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %8 = call i32 (i8*, ...)* @printf(i8* %7, i32 %Phi10.lcssa)
  ret i32 0

for.body2:                                        ; preds = %alias.header, %for.body2
  %Phi819 = phi i32 [ %Phi1021, %alias.header ], [ %add, %for.body2 ]
  %Phi518 = phi i32 [ 0, %alias.header ], [ %add9, %for.body2 ]
  %add = add i32 %Phi819, %.alloca.0.
  %add9 = add i32 %Phi518, 1
  %lt6 = icmp slt i32 %add9, 10
  br i1 %lt6, label %for.body2, label %for.end4, !prof !0

for.end4:                                         ; preds = %for.body2
  %Phi8.lcssa = phi i32 [ %add, %for.body2 ]
  %div = sdiv i32 %Phi20, 5
  %mul = mul i32 %div, 5
  %sub = sub i32 %Phi20, %mul
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !1

if.then:                                          ; preds = %for.end4
  %add13 = add i32 %Phi20, 2
  store i32 %add13, i32* %5
  br label %if.end

if.end:                                           ; preds = %if.then, %for.end4
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.0., %for.end4 ]
  %add15 = add i32 %Phi20, 1
  %lt = icmp slt i32 %add15, 10
  br i1 %lt, label %alias.header, label %for.end, !prof !2
}

!0 = metadata !{metadata !"branch_weights", i32 100, i32 10}
!1 = metadata !{metadata !"branch_weights", i32 2, i32 8}
!2 = metadata !{metadata !"branch_weights", i32 10, i32 1}
