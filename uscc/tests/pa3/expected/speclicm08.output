; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [2 x i32], align 8
  %0 = getelementptr inbounds [2 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 6, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 0
  %4 = load i32* %3
  %mul = mul i32 %4, 3
  %add = add i32 %mul, 7
  %sub = sub i32 %add, 2
  %mul2 = mul i32 %sub, 2
  %add3 = add i32 %mul2, 5
  %5 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %3, %5
  br label %alias.header

alias.header:                                     ; preds = %if.end, %entry
  %add3.alloca.0 = phi i32 [ %add3, %entry ], [ %add3.alloca.1, %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi414 = phi i32 [ 0, %entry ], [ %add5, %if.end ]
  %Phi13 = phi i32 [ 0, %entry ], [ %add10, %if.end ]
  %neg.alias = icmp eq i1 %alias.0, false
  br i1 %neg.alias, label %while.body, label %alias.fixup

alias.fixup:                                      ; preds = %alias.header
  %6 = load i32* %3
  %7 = mul i32 %6, 3
  %8 = add i32 %7, 7
  %9 = sub i32 %8, 2
  %10 = mul i32 %9, 2
  %11 = add i32 %10, 5
  br label %while.body

while.body:                                       ; preds = %alias.header, %alias.fixup
  %add3.alloca.1 = phi i32 [ %add3.alloca.0, %alias.header ], [ %11, %alias.fixup ]
  %alias.1 = phi i1 [ %alias.0, %alias.header ], [ false, %alias.fixup ]
  %add5 = add i32 %Phi414, %add3.alloca.1
  %div = sdiv i32 %Phi13, 12
  %mul6 = mul i32 %div, 12
  %sub7 = sub i32 %Phi13, %mul6
  %eq = icmp eq i32 %sub7, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

while.end:                                        ; preds = %if.end
  %Phi4.lcssa = phi i32 [ %add5, %if.end ]
  %12 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %13 = call i32 (i8*, ...)* @printf(i8* %12, i32 %Phi4.lcssa)
  ret i32 0

if.then:                                          ; preds = %while.body
  %add8 = add i32 %Phi13, 3
  store i32 %add8, i32* %5
  br label %if.end

if.end:                                           ; preds = %if.then, %while.body
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.1, %while.body ]
  %add10 = add i32 %Phi13, 1
  %lt = icmp slt i32 %add10, 50
  br i1 %lt, label %alias.header, label %while.end, !prof !1
}

!0 = metadata !{metadata !"branch_weights", i32 5, i32 45}
!1 = metadata !{metadata !"branch_weights", i32 50, i32 1}
