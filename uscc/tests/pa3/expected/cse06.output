; ModuleID = 'main'

@.str = private unnamed_addr constant [20 x i8] c"x2=%d, y2=%d, z=%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %z.addr = alloca i32
  %x2.addr = alloca i32
  %y1.addr = alloca i32
  %x1.addr = alloca i32
  %c.addr = alloca i32
  %b.addr = alloca i32
  %y2.addr = alloca i32
  %a.addr = alloca i32
  store i32 2, i32* %a.addr
  store i32 3, i32* %b.addr
  store i32 4, i32* %c.addr
  %b = load i32* %b.addr
  %a = load i32* %a.addr
  %add = add i32 %a, %b
  store i32 %add, i32* %x1.addr
  %c = load i32* %c.addr
  %b1 = load i32* %b.addr
  %mul = mul i32 %b1, %c
  store i32 %mul, i32* %y1.addr
  %y1 = load i32* %y1.addr
  %x1 = load i32* %x1.addr
  %add2 = add i32 %x1, %y1
  store i32 %add2, i32* %z.addr
  store i32 %add, i32* %x2.addr
  store i32 %mul, i32* %y2.addr
  %x2 = load i32* %x2.addr
  %y2 = load i32* %y2.addr
  %z = load i32* %z.addr
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([20 x i8]* @.str, i32 0, i32 0), i32 %x2, i32 %y2, i32 %z)
  ret i32 0
}
