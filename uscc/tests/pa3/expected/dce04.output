; ModuleID = 'main'

define i32 @bar(i32 %N) {
entry:
  %gt = icmp sgt i32 5, %N
  br i1 %gt, label %if.then, label %if.else

if.then:                                          ; preds = %entry
  %add1 = add i32 0, 5
  br label %if.end

if.end:                                           ; preds = %if.then, %if.else
  %add2 = add i32 5, %N
  ret i32 %add2

if.else:                                          ; preds = %entry
  %add = add i32 0, %N
  br label %if.end
}
