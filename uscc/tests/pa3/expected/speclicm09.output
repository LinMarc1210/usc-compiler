; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %out = alloca [64 x i32], align 8
  %0 = getelementptr inbounds [64 x i32]* %out, i32 0, i32 0
  %arr = alloca [4 x i32], align 8
  %1 = getelementptr inbounds [4 x i32]* %arr, i32 0, i32 0
  %2 = getelementptr inbounds i32* %1, i32 0
  store i32 5, i32* %2
  %3 = getelementptr inbounds i32* %1, i32 1
  store i32 0, i32* %3
  %4 = getelementptr inbounds i32* %1, i32 2
  store i32 0, i32* %4
  %5 = getelementptr inbounds i32* %1, i32 3
  store i32 0, i32* %5
  %6 = getelementptr inbounds i32* %1, i32 0
  %7 = load i32* %6
  %mul = mul i32 %7, 3
  %add = add i32 %mul, 1
  %8 = getelementptr inbounds i32* %1, i32 0
  %alias.cmp = icmp eq i32* %6, %8
  br label %alias.header

alias.header:                                     ; preds = %if.end, %entry
  %add.alloca.0 = phi i32 [ %add, %entry ], [ %add.alloca.1, %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi22 = phi i32 [ 0, %entry ], [ %add6, %if.end ]
  %neg.alias = icmp eq i1 %alias.0, false
  br i1 %neg.alias, label %while.body, label %alias.fixup

alias.fixup:                                      ; preds = %alias.header
  %9 = load i32* %6
  %10 = mul i32 %9, 3
  %11 = add i32 %10, 1
  br label %while.body

while.body:                                       ; preds = %alias.header, %alias.fixup
  %add.alloca.1 = phi i32 [ %add.alloca.0, %alias.header ], [ %11, %alias.fixup ]
  %alias.1 = phi i1 [ %alias.0, %alias.header ], [ false, %alias.fixup ]
  %12 = getelementptr inbounds i32* %0, i32 %Phi22
  store i32 %add.alloca.1, i32* %12
  %div = sdiv i32 %Phi22, 16
  %mul3 = mul i32 %div, 16
  %sub = sub i32 %Phi22, %mul3
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

if.then:                                          ; preds = %while.body
  %add4 = add i32 %Phi22, 7
  store i32 %add4, i32* %8
  br label %if.end

if.end:                                           ; preds = %if.then, %while.body
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.1, %while.body ]
  %add6 = add i32 %Phi22, 1
  %lt = icmp slt i32 %add6, 32
  br i1 %lt, label %alias.header, label %while.body12, !prof !1

while.body12:                                     ; preds = %if.end, %while.body12
  %Phi1521 = phi i32 [ %add16, %while.body12 ], [ 0, %if.end ]
  %Phi1020 = phi i32 [ %add17, %while.body12 ], [ 0, %if.end ]
  %13 = getelementptr inbounds i32* %0, i32 %Phi1020
  %14 = load i32* %13
  %add16 = add i32 %Phi1521, %14
  %add17 = add i32 %Phi1020, 1
  %lt11 = icmp slt i32 %add17, 32
  br i1 %lt11, label %while.body12, label %while.end13, !prof !1

while.end13:                                      ; preds = %while.body12
  %Phi15.lcssa = phi i32 [ %add16, %while.body12 ]
  %15 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %16 = call i32 (i8*, ...)* @printf(i8* %15, i32 %Phi15.lcssa)
  ret i32 0
}

!0 = metadata !{metadata !"branch_weights", i32 2, i32 30}
!1 = metadata !{metadata !"branch_weights", i32 32, i32 1}
