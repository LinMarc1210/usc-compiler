; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [2 x i32], align 8
  %0 = getelementptr inbounds [2 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 4, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 0
  %4 = load i32* %3
  %5 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %3, %5
  br label %alias.header

alias.header:                                     ; preds = %if.end, %entry
  %.alloca.0 = phi i32 [ %4, %entry ], [ %.alloca.0., %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi222 = phi i32 [ 0, %entry ], [ %add, %if.end ]
  %Phi21 = phi i32 [ 0, %entry ], [ %add5, %if.end ]
  %neg.alias = icmp eq i1 %alias.0, false
  %6 = load i32* %3
  %.alloca.0. = select i1 %neg.alias, i32 %.alloca.0, i32 %6
  %alias.0. = select i1 %neg.alias, i1 %alias.0, i1 false
  %add = add i32 %Phi222, %.alloca.0.
  %div = sdiv i32 %Phi21, 15
  %mul = mul i32 %div, 15
  %sub = sub i32 %Phi21, %mul
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

for.end:                                          ; preds = %if.end
  %Phi2.lcssa = phi i32 [ %add, %if.end ]
  br label %for.body9

if.then:                                          ; preds = %alias.header
  %add3 = add i32 %Phi21, 1
  store i32 %add3, i32* %5
  br label %if.end

if.end:                                           ; preds = %if.then, %alias.header
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.0., %alias.header ]
  %add5 = add i32 %Phi21, 1
  %lt = icmp slt i32 %add5, 30
  br i1 %lt, label %alias.header, label %for.end, !prof !1

for.body9:                                        ; preds = %for.end, %for.body9
  %Phi1420 = phi i32 [ 0, %for.end ], [ %add15, %for.body9 ]
  %Phi1219 = phi i32 [ 0, %for.end ], [ %add16, %for.body9 ]
  %add15 = add i32 %Phi1420, %Phi1219
  %add16 = add i32 %Phi1219, 1
  %lt13 = icmp slt i32 %add16, 10
  br i1 %lt13, label %for.body9, label %for.end11, !prof !2

for.end11:                                        ; preds = %for.body9
  %Phi14.lcssa = phi i32 [ %add15, %for.body9 ]
  %7 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %add18 = add i32 %Phi2.lcssa, %Phi14.lcssa
  %8 = call i32 (i8*, ...)* @printf(i8* %7, i32 %add18)
  ret i32 0
}

!0 = metadata !{metadata !"branch_weights", i32 2, i32 28}
!1 = metadata !{metadata !"branch_weights", i32 30, i32 1}
!2 = metadata !{metadata !"branch_weights", i32 10, i32 1}
