; ModuleID = 'main'

@.str = private unnamed_addr constant [6 x i8] c"y=%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %temp.addr = alloca i32
  %i.addr = alloca i32
  %j.addr = alloca i32
  %y.addr = alloca i32
  %x.addr = alloca i32
  %b.addr = alloca i32
  %a.addr = alloca i32
  store i32 100, i32* %a.addr
  store i32 0, i32* %b.addr
  store i32 0, i32* %y.addr
  store i32 1, i32* %i.addr
  br label %while.cond

while.cond:                                       ; preds = %while.end5, %entry
  %i = load i32* %i.addr
  %lt = icmp slt i32 %i, 4
  br i1 %lt, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  store i32 0, i32* %j.addr
  %i1 = load i32* %i.addr
  %a = load i32* %a.addr
  %div = sdiv i32 %a, %i1
  store i32 %div, i32* %temp.addr
  br label %while.cond2

while.end:                                        ; preds = %while.cond
  %y13 = load i32* %y.addr
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([6 x i8]* @.str, i32 0, i32 0), i32 %y13)
  ret i32 0

while.cond2:                                      ; preds = %while.body4, %while.body
  %j = load i32* %j.addr
  %lt3 = icmp slt i32 %j, 3
  br i1 %lt3, label %while.body4, label %while.end5

while.body4:                                      ; preds = %while.cond2
  %i6 = load i32* %i.addr
  %a7 = load i32* %a.addr
  %div8 = sdiv i32 %a7, %i6
  %y = load i32* %y.addr
  %add = add i32 %y, %div8
  store i32 %add, i32* %y.addr
  %j9 = load i32* %j.addr
  %add10 = add i32 %j9, 1
  store i32 %add10, i32* %j.addr
  br label %while.cond2

while.end5:                                       ; preds = %while.cond2
  %i11 = load i32* %i.addr
  %add12 = add i32 %i11, 1
  store i32 %add12, i32* %i.addr
  br label %while.cond
}
