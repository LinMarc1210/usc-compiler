// cse07.usc

int main() {
    int a;
    int b;
    int x; // Result of a / i
    int y; // Accumulator
    int i;
    int j;
    int temp; // Hold inner loop CSE result

    a = 100;
    b = 0; // Unused
    y = 0;
    i = 1;
    while (i < 4) { // Outer loop
        j = 0;
        temp = a / i; // Compute a / i once per outer loop
        while (j < 3) { // Inner loop
            // CSE should reuse 'temp'
            y = y + (a / i);
            j = j + 1;
        }
        i = i + 1;
    }
    printf("y=%d\n", y); // Expected y=549
    return 0;
}
