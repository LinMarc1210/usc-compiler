// cse08.usc
// CSE involving constants within control flow.

int main() {
    int a;
    int x;
    int y;
    int z; // Usage

    a = 10;
    x = a + 5; // Compute e1: a + 5
    z = x * 2; // Use x
    y = a + 5; // Reuse e1

    printf("y=%d, z=%d\n", y, z); // Expected: y=15, z=30
    return 0;
}
