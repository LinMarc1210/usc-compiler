int main() {
    int a;
    int b;
    int x;
    int y;
    int i;
    int j;

    a = 1;
    b = 2;
    y = 0;
    i = 0;
    while (i < 3) {
        x = a + b;
        j = 0;
        while (j < 5) {
            y = y + (a + b);
            j = j + 1;
        }
        a = a + 1;
        i = i + 1;
    }
    printf("y=%d\n", y);
    return 0;
}
