int main() {
    int a;
    int b;
    int x;
    int y;
    int i;
    int j;

    a = 5;
    b = 3;
    x = a - b;
    y = 0;
    i = 0;
    while (i < 2) {
        j = 0;
        while (j < 2) {
            y = a - b;

            if (i == 1) {
                if (j == 0) {
                    a = 10;
                }
            }

            j = j + 1;
        }
        i = i + 1;
    }
    x = a - b;
    printf("x=%d, y=%d\n", x, y);
    return 0;
}
