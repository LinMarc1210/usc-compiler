int main() {
    int a;
    int b;
    int x;
    int y;
    int i;
    int j;

    a = 10;
    b = 2;
    x = a * b;
    y = 0;
    i = 0;
    while (i < 3) {
        j = 0;
        while (j < 4) {
            y = y + (a * b);
            j = j + 1;
        }
        i = i + 1;
    }
    printf("y=%d\n", y);
    return 0;
}
