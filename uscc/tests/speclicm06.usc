// fplicm06.usc
// Three infrequent stores to the same address via separate branches.
// Exercises the alias tracker creating multiple alias.cmp insertions
// inside specHoistInst for a single load.
int main()
{
	int arr[4];
	int i;
	int sum;

	arr[0] = 3;
	arr[1] = 0;
	arr[2] = 0;
	arr[3] = 0;

	i = 0;
	sum = 0;
	while (i < 120)
	{
		sum = sum + arr[0];
		if (i - ((i / 17) * 17) == 0)
		{
			arr[0] = 5;
		}
		if (i - ((i / 23) * 23) == 0)
		{
			arr[0] = 7;
		}
		if (i - ((i / 41) * 41) == 0)
		{
			arr[0] = 11;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
