// peeltest05.usc
// Loop Peeling Test: Mixed Peelability
// Tests: One non-peelable followed by one peelable loop
//---------------------------------------------------------

int main()
{
	int x = 0;
	int y = 0;
	int sum = 0;
	++x;
	while (x < 5)
	{
		sum = sum + x;
		++x;
	}
	while (y < 3)
	{
		sum = sum + y;
		++y;
	}
	printf("%d\n", sum);
	return 0;
}
