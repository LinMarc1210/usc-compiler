// fplicm26.usc
// End-to-end stress: nested loops with dependent-chain hoisting in the
// INNER loop and infrequent stores at the inner level. The nested-guard
// in specHoistInst skips the chain-hoist for inner loops so the inner
// alias.header / fix-up machinery runs without tripping outer-loop
// LoopInfo/DomTree invalidation.
int main()
{
	int arr[2];
	int i;
	int j;
	int sum;

	arr[0] = 2;
	arr[1] = 0;

	sum = 0;
	for (i = 0; i < 6; i = i + 1)
	{
		for (j = 0; j < 15; j = j + 1)
		{
			sum = sum + (arr[0] * 5 + 3);
			if (j - ((j / 7) * 7) == 0)
			{
				arr[0] = i + j + 1;
			}
		}
	}

	printf("%d\n", sum);
	return 0;
}
