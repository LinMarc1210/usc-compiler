// fplicm11.usc
// Nested loops. Outer loop modifies an "occasionally updated" cell; inner
// loop reads arr[0] on its frequent path. FPLICM should process the
// inner loop first (innermost-first LoopPass order) and hoist the load
// into the inner preheader. On a subsequent visit the outer loop might
// see the inner-preheader load as invariant at its own level.
int main()
{
	int arr[4];
	int i;
	int j;
	int sum;

	arr[0] = 5;
	arr[1] = 0;
	arr[2] = 0;
	arr[3] = 0;

	i = 0;
	sum = 0;
	while (i < 8)
	{
		j = 0;
		while (j < 10)
		{
			sum = sum + arr[0];
			j = j + 1;
		}
		if (i - ((i / 4) * 4) == 0)
		{
			arr[0] = i + 3;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
