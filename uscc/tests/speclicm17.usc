// fplicm17.usc
// Nested for-loops. Inner load, outer infrequent store.
int main()
{
	int arr[2];
	int i;
	int j;
	int sum;

	arr[0] = 6;
	arr[1] = 0;

	sum = 0;
	for (i = 0; i < 10; i = i + 1)
	{
		for (j = 0; j < 10; j = j + 1)
		{
			sum = sum + arr[0];
		}
		if (i - ((i / 5) * 5) == 0)
		{
			arr[0] = i + 2;
		}
	}

	printf("%d\n", sum);
	return 0;
}
