// edgeprof20.usc
// Pattern: Comprehensive Benchmark (all patterns combined)
// Tests edge profiling with all control flow patterns
// ~60 edges, mixed iteration counts (reduced for multi-function manageability)
//---------------------------------------------------------

int helper(int n, int mode)
{
    int result = 0;
    if (mode == 0)
    {
        if (n > 50)
        {
            result = n * 2;
        }
        else
        {
            result = n + 10;
        }
    }
    else if (mode == 1)
    {
        int i = 0;
        while (i < 5)
        {
            result = result + n;
            i = i + 1;
        }
    }
    else
    {
        result = n;
    }
    return result;
}

int main()
{
    int i = 0;
    int j = 0;
    int k = 0;
    int sum = 0;
    int temp = 0;
    int state = 0;

    // Pattern 1: Deeply nested loops
    while (i < 10)
    {
        j = 0;
        while (j < 10)
        {
            k = 0;
            while (k < 5)
            {
                if (i > j)
                {
                    if (j > k)
                    {
                        sum = sum + 1;
                    }
                    else
                    {
                        sum = sum + 2;
                    }
                }
                else
                {
                    sum = sum + 3;
                }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Pattern 2: State machine simulation
    i = 0;
    while (i < 100)
    {
        if (state == 0)
        {
            if (i % 3 == 0)
            {
                state = 1;
            }
            else
            {
                state = 2;
            }
        }
        else if (state == 1)
        {
            if (i % 2 == 0)
            {
                state = 0;
            }
            else
            {
                state = 2;
            }
        }
        else
        {
            state = 0;
        }
        temp = temp + helper(i % 100, state);
        i = i + 1;
    }

    // Pattern 3: Chained diamonds
    i = 0;
    while (i < 1000)
    {
        if (i % 2 == 0)
        {
            sum = sum + 1;
        }
        else
        {
            sum = sum - 1;
        }

        if (i % 3 == 0)
        {
            sum = sum + 2;
        }
        else
        {
            sum = sum - 2;
        }

        if (i % 5 == 0)
        {
            sum = sum + 3;
        }
        else
        {
            sum = sum - 3;
        }

        i = i + 1;
    }

    // Pattern 4: Continue/break style control flow
    i = 0;
    while (i < 1000)
    {
        i = i + 1;
        if (i % 7 == 0)
        {
            continue;
        }
        if (i % 11 == 0)
        {
            continue;
        }
        sum = sum + i;
    }

    // Pattern 5: Final conditional cascade
    if (sum > 10000)
    {
        if (temp > 5000)
        {
            sum = sum / 2;
        }
        else
        {
            sum = sum / 3;
        }
    }
    else if (sum > 5000)
    {
        sum = sum / 4;
    }
    else
    {
        sum = sum + 1;
    }

    return 0;
}
