// fplicm12.usc
// Nested loops with the infrequent store INSIDE the inner loop. The
// inner-loop load should still hoist to the inner preheader (the
// infrequent store never runs on the inner frequent path).
int main()
{
	int arr[4];
	int i;
	int j;
	int sum;

	arr[0] = 3;
	arr[1] = 0;
	arr[2] = 0;
	arr[3] = 0;

	i = 0;
	sum = 0;
	while (i < 6)
	{
		j = 0;
		while (j < 12)
		{
			sum = sum + arr[0];
			if (j - ((j / 8) * 8) == 0)
			{
				arr[0] = j + 1;
			}
			j = j + 1;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
