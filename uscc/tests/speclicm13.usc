// fplicm13.usc
// Nested loops, dependent-chain hoist at the inner level. Tests that
// collectDependentChain + moveBefore works correctly in combination with
// nested-loop FPLICM invocations.
int main()
{
	int arr[2];
	int i;
	int j;
	int sum;

	arr[0] = 7;
	arr[1] = 0;

	i = 0;
	sum = 0;
	while (i < 5)
	{
		j = 0;
		while (j < 20)
		{
			sum = sum + (arr[0] * 4 + 1);
			if (j - ((j / 10) * 10) == 0)
			{
				arr[0] = i + j + 2;
			}
			j = j + 1;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
