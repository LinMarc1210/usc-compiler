// fplicm04.usc
// A chain of TWO dependent computations on a single hoisted load.
// The ~`(arr[0] * 7) + 3` value is fully loop-invariant on the frequent
// path; collectDependentChain should hoist BOTH the `mul` and the `add`
// into the preheader, leaving only `sum + chain_result` per iteration.
int main()
{
	int arr[2];
	int i;
	int sum;

	arr[0] = 4;
	arr[1] = 0;

	i = 0;
	sum = 0;
	while (i < 48)
	{
		sum = sum + (arr[0] * 7 + 3);
		if (i - ((i / 24) * 24) == 0)
		{
			arr[0] = i + 1;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
