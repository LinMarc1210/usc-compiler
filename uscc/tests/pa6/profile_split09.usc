// profile_split09.usc
// Two-phase program: a cold setup phase that is itself a small loop,
// followed by a hot accumulation loop. Tests that the split decision
// between the two loops correctly identifies cold->hot boundary on
// the second loop's preheader.
// Expected output: 495
int main()
{
	int arr[10];
	int i;
	int sum;

	// cold setup loop (freq low — runs once at entry)
	i = 0;
	while (i < 10)
	{
		arr[i] = i;
		i = i + 1;
	}

	// hot accumulation loop (freq high)
	sum = 0;
	i = 0;
	while (i < 10)
	{
		int j;
		j = 0;
		while (j < 11)
		{
			sum = sum + arr[i];
			j = j + 1;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
