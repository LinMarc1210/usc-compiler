// profile_split02.usc
// Nested hot loops with a loop-invariant computed in the cold entry.
// Under baseline, the invariants may spill inside the nested hot
// loop. Under -profile-split the cold->hot boundary around the outer loop
// preheader is kept split (Rule 3), keeping the invariant in a
// register throughout the hot region.
// Expected output: 135000
int main()
{
	int base;
	int acc;
	int a;
	int b;
	int c;
	int d;
	int e;
	int i;
	int j;

	// cold: compute a constant from several locals
	a = 3;
	b = 7;
	c = 11;
	d = 13;
	e = 17;
	base = a + b * c - d + e * 2;

	acc = 0;
	i = 0;

	// hot: doubly-nested loop using `base` on every iteration
	while (i < 50)
	{
		j = 0;
		while (j < 20)
		{
			acc = acc + base + j + i;
			j = j + 1;
		}
		i = i + 1;
	}

	printf("%d\n", acc);
	return 0;
}
