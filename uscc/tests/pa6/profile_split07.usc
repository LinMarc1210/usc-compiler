// profile_split07.usc
// Cold initialization of an array + hot summation loop. Exercises
// live-range splitting on the array pointer and the loop index
// across the hot-loop preheader boundary.
// Expected output: 4950
int main()
{
	int arr[10];
	int i;
	int sum;

	// cold initialization
	arr[0] = 0;
	arr[1] = 10;
	arr[2] = 20;
	arr[3] = 30;
	arr[4] = 40;
	arr[5] = 50;
	arr[6] = 60;
	arr[7] = 70;
	arr[8] = 80;
	arr[9] = 90;

	// hot: doubly-nested loop sums each element several times
	i = 0;
	sum = 0;
	while (i < 10)
	{
		int j;
		j = 0;
		while (j < 11)
		{
			sum = sum + arr[i];
			j = j + 1;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
