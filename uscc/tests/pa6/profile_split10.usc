// profile_split10.usc
// Hot loop with very high register pressure (many live locals) and
// a cold prologue. Exercises profile-split's spill-priority formula
// `F / NumSaturationPoints`: the cold prologue's defs should spill
// while hot-loop state stays in registers.
// Expected output: 38700
int main()
{
	int w;
	int x;
	int y;
	int z;
	int p;
	int q;
	int r;
	int s;
	int t;
	int u;
	int i;
	int acc;

	// cold prologue: many locals initialised once
	w = 2;
	x = 3;
	y = 5;
	z = 7;
	p = 11;
	q = 13;
	r = 17;
	s = 19;
	t = 23;
	u = 29;

	acc = 0;
	i = 0;

	// hot loop: all 10 locals used per iteration
	while (i < 300)
	{
		acc = acc + w + x + y + z + p + q + r + s + t + u;
		i = i + 1;
	}

	printf("%d\n", acc);
	return 0;
}
