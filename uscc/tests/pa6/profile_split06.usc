// profile_split06.usc
// Triple-nested loops with a cold-computed invariant. The outermost
// loop iterates few times; the innermost runs many. Profile data
// places the innermost join on the hot side and the outer entry on
// the cold side — Rule 3 keeps the cold->hot split on the outer
// preheader and coalesces the hot-hot joins inside the inner loop.
// Expected output: 33000
int main()
{
	int base;
	int a;
	int b;
	int c;
	int i;
	int j;
	int k;
	int acc;

	// cold
	a = 2;
	b = 3;
	c = 5;
	base = a * b + c;

	acc = 0;
	i = 0;
	while (i < 10)
	{
		j = 0;
		while (j < 15)
		{
			k = 0;
			while (k < 20)
			{
				acc = acc + base;
				k = k + 1;
			}
			j = j + 1;
		}
		i = i + 1;
	}

	printf("%d\n", acc);
	return 0;
}
