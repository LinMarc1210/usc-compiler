// edgeprof07.usc
// Pattern: Cascading Conditionals (8 sequential if-else-if)
// Tests sequential decision points
// ~20 edges, 200000000 loops
//---------------------------------------------------------

int main()
{
    int i = 0;
    int result = 0;

    while (i < 200000000)
    {
        int val = i % 8;

        if (val == 0)
        {
            result = result + 1;
        }
        else if (val == 1)
        {
            result = result + 2;
        }
        else if (val == 2)
        {
            result = result + 3;
        }
        else if (val == 3)
        {
            result = result + 4;
        }
        else if (val == 4)
        {
            result = result + 5;
        }
        else if (val == 5)
        {
            result = result + 6;
        }
        else if (val == 6)
        {
            result = result + 7;
        }
        else
        {
            result = result + 8;
        }

        i = i + 1;
    }
    return 0;
}
