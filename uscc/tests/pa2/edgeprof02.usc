// edgeprof02.usc
// Pattern: Wide Branch Tree (8-way branching)
// Tests edge profiling with many edges and few chords relative to nodes
// ~25 edges, 200000000 loop iterations
//---------------------------------------------------------

int main()
{
    int x = 0;
    int result = 0;

    while (x < 200000000)
    {
        int val = x % 8;
        if (val == 0)
        {
            result = result + 1;
        }
        else if (val == 1)
        {
            result = result + 2;
        }
        else if (val == 2)
        {
            result = result + 3;
        }
        else if (val == 3)
        {
            result = result + 4;
        }
        else if (val == 4)
        {
            result = result + 5;
        }
        else if (val == 5)
        {
            result = result + 6;
        }
        else if (val == 6)
        {
            result = result + 7;
        }
        else
        {
            result = result + 8;
        }
        x = x + 1;
    }
    return 0;
}
