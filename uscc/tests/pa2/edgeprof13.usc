// edgeprof13.usc
// Pattern: State Machine Simulation (6 states)
// Tests many cross-edges with state transitions
// ~32 edges, 200000000 transitions
//---------------------------------------------------------

int main()
{
    int state = 0;
    int counter = 0;

    while (counter < 200000000)
    {
        if (state == 0)
        {
            if (counter % 7 == 0)
            {
                state = 1;
            }
            else if (counter % 5 == 0)
            {
                state = 2;
            }
            else
            {
                state = 3;
            }
        }
        else if (state == 1)
        {
            if (counter % 3 == 0)
            {
                state = 4;
            }
            else
            {
                state = 0;
            }
        }
        else if (state == 2)
        {
            if (counter % 2 == 0)
            {
                state = 5;
            }
            else
            {
                state = 1;
            }
        }
        else if (state == 3)
        {
            state = 0;
        }
        else if (state == 4)
        {
            if (counter % 11 == 0)
            {
                state = 0;
            }
            else
            {
                state = 5;
            }
        }
        else
        {
            state = 0;
        }

        counter = counter + 1;
    }
    return 0;
}
