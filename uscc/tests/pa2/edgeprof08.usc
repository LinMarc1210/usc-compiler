// edgeprof08.usc
// Pattern: Triple Nested with Cross-Branches
// Tests complex CFG structure with 3 nesting levels and branching
// ~35 edges, 200x200x200 = 8M iterations
//---------------------------------------------------------

int main()
{
    int i = 0;
    int j = 0;
    int k = 0;
    int sum = 0;

    while (i < 200)
    {
        j = 0;
        while (j < 200)
        {
            k = 0;
            while (k < 200)
            {
                if (i > j)
                {
                    if (j > k)
                    {
                        sum = sum + 1;
                    }
                    else
                    {
                        sum = sum + 2;
                    }
                }
                else
                {
                    if (k > i)
                    {
                        sum = sum + 3;
                    }
                    else
                    {
                        sum = sum + 4;
                    }
                }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
