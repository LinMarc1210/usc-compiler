// edgeprof12.usc
// Pattern: Matrix-Style Double Loop + Checks
// Tests classic nested iteration with conditional checks
// ~30 edges, 15000x15000 = 225M iterations
//---------------------------------------------------------

int main()
{
    int i = 0;
    int j = 0;
    int sum = 0;
    int diag = 0;
    int upper = 0;
    int lower = 0;

    while (i < 15000)
    {
        j = 0;
        while (j < 15000)
        {
            if (i == j)
            {
                diag = diag + 1;
            }
            else if (i < j)
            {
                upper = upper + 1;
            }
            else
            {
                lower = lower + 1;
            }

            sum = sum + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
