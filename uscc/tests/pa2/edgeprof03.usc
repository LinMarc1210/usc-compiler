// edgeprof03.usc
// Pattern: Loop with 5 Conditionals
// Tests per-iteration branching overhead
// ~18 edges, 200000000 iterations
//---------------------------------------------------------

int main()
{
    int i = 0;
    int sum = 0;

    while (i < 200000000)
    {
        if (i % 2 == 0)
        {
            sum = sum + 1;
        }
        if (i % 3 == 0)
        {
            sum = sum + 2;
        }
        if (i % 5 == 0)
        {
            sum = sum + 3;
        }
        if (i % 7 == 0)
        {
            sum = sum + 4;
        }
        if (i % 11 == 0)
        {
            sum = sum + 5;
        }
        i = i + 1;
    }
    return 0;
}
