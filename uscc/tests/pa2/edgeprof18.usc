// edgeprof18.usc
// Pattern: Loop Unrolling Simulation (4x unrolled)
// Tests many sequential edges from simulated unrolling
// ~40 edges, 100M effective iterations (400M/4 step)
//---------------------------------------------------------

int main()
{
    int i = 0;
    int sum = 0;

    while (i < 400000000)
    {
        // Simulated unrolled iteration 1
        if (i % 4 == 0)
        {
            sum = sum + 1;
        }
        else
        {
            sum = sum + 2;
        }

        // Simulated unrolled iteration 2
        if ((i + 1) % 4 == 0)
        {
            sum = sum + 3;
        }
        else
        {
            sum = sum + 4;
        }

        // Simulated unrolled iteration 3
        if ((i + 2) % 4 == 0)
        {
            sum = sum + 5;
        }
        else
        {
            sum = sum + 6;
        }

        // Simulated unrolled iteration 4
        if ((i + 3) % 4 == 0)
        {
            sum = sum + 7;
        }
        else
        {
            sum = sum + 8;
        }

        // Check for overflow simulation
        if (sum > 10000)
        {
            sum = sum / 2;
        }

        i = i + 4;
    }
    return 0;
}
