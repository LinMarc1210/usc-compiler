// edgeprof16.usc
// Pattern: Multi-Function Complex (3 functions)
// Tests per-function profiling with multiple functions
// ~45 edges total across functions, 30 outer x 10 inner
//---------------------------------------------------------

int compute(int x, int mode)
{
    int result = 0;

    if (mode == 0)
    {
        if (x > 50)
        {
            result = x * 2;
        }
        else
        {
            result = x + 10;
        }
    }
    else if (mode == 1)
    {
        if (x % 2 == 0)
        {
            result = x / 2;
        }
        else
        {
            result = x * 3 + 1;
        }
    }
    else
    {
        result = x;
    }

    return result;
}

int process(int val)
{
    int i = 0;
    int sum = 0;

    while (i < 10)
    {
        if (val > i)
        {
            sum = sum + compute(val, 0);
        }
        else
        {
            sum = sum + compute(val, 1);
        }
        i = i + 1;
    }

    return sum;
}

int main()
{
    int i = 0;
    int total = 0;

    while (i < 30)
    {
        if (i % 3 == 0)
        {
            total = total + process(i);
        }
        else if (i % 3 == 1)
        {
            total = total + compute(i, 0);
        }
        else
        {
            total = total + compute(i, 2);
        }
        i = i + 1;
    }
    return 0;
}
