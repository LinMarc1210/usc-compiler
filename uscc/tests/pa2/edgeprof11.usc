// edgeprof11.usc
// Pattern: Deep Recursive-Style Nesting (5 levels)
// Tests simulated deep call stack with nested structures
// ~25 edges, 200000000 iterations
//---------------------------------------------------------

int main()
{
    int i = 0;
    int a = 0;
    int b = 0;
    int c = 0;
    int d = 0;
    int e = 0;

    while (i < 200000000)
    {
        a = i % 32;
        if (a < 16)
        {
            b = a % 8;
            if (b < 4)
            {
                c = b % 2;
                if (c < 1)
                {
                    d = i % 3;
                    if (d == 0)
                    {
                        e = e + 1;
                    }
                    else
                    {
                        e = e + 2;
                    }
                }
                else
                {
                    e = e + 3;
                }
            }
            else
            {
                e = e + 4;
            }
        }
        else
        {
            e = e + 5;
        }
        i = i + 1;
    }
    return 0;
}
