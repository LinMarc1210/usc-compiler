// edgeprof14.usc
// Pattern: Binary Search Tree Traversal Simulation
// Tests logarithmic paths with binary decisions
// ~28 edges, 500000 searches x ~19 steps = ~9.5M iterations
//---------------------------------------------------------

int main()
{
    int target = 0;
    int found = 0;
    int comparisons = 0;

    while (target < 500000)
    {
        int low = 0;
        int high = 499999;
        int mid = 0;

        while (low < high)
        {
            mid = (low + high) / 2;
            comparisons = comparisons + 1;

            if (mid == target)
            {
                found = found + 1;
                low = high;
            }
            else if (mid < target)
            {
                low = mid + 1;
            }
            else
            {
                high = mid;
            }
        }

        target = target + 1;
    }
    return 0;
}
