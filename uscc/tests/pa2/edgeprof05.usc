// edgeprof05.usc
// Pattern: Multiple Nested Loops + Branches
// Tests combined complexity with nested loops and conditionals
// ~30 edges, 15000x15000 = 225M iterations
//---------------------------------------------------------

int main()
{
    int i = 0;
    int j = 0;
    int sum = 0;

    while (i < 15000)
    {
        j = 0;
        while (j < 15000)
        {
            if (i > j)
            {
                sum = sum + 1;
            }
            else if (i == j)
            {
                sum = sum + 2;
            }
            else
            {
                sum = sum + 3;
            }

            if (sum % 100 == 0)
            {
                sum = sum / 2;
            }

            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
