// edgeprof06.usc
// Pattern: Loop with Early Exit (10 conditions)
// Tests many break paths in a loop
// ~24 edges, 200000000 iterations
//---------------------------------------------------------

int main()
{
    int i = 0;
    int result = 0;

    while (i < 200000000)
    {
        int val = i % 100;

        if (val == 0)
        {
            result = result + 1;
        }
        if (val == 10)
        {
            result = result + 2;
        }
        if (val == 20)
        {
            result = result + 3;
        }
        if (val == 30)
        {
            result = result + 4;
        }
        if (val == 40)
        {
            result = result + 5;
        }
        if (val == 50)
        {
            result = result + 6;
        }
        if (val == 60)
        {
            result = result + 7;
        }
        if (val == 70)
        {
            result = result + 8;
        }
        if (val == 80)
        {
            result = result + 9;
        }
        if (val == 90)
        {
            result = result + 10;
        }

        i = i + 1;
    }
    return 0;
}
