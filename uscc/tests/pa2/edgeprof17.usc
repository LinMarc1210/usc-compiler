// edgeprof17.usc
// Pattern: Diamond Patterns Chained (5 diamonds)
// Tests repeated merge points
// ~35 edges, 200000000 iterations
//---------------------------------------------------------

int main()
{
    int i = 0;
    int result = 0;

    while (i < 200000000)
    {
        // Diamond 1
        if (i % 2 == 0)
        {
            result = result + 1;
        }
        else
        {
            result = result + 2;
        }

        // Diamond 2
        if (i % 3 == 0)
        {
            result = result + 3;
        }
        else
        {
            result = result + 4;
        }

        // Diamond 3
        if (i % 5 == 0)
        {
            result = result + 5;
        }
        else
        {
            result = result + 6;
        }

        // Diamond 4
        if (i % 7 == 0)
        {
            result = result + 7;
        }
        else
        {
            result = result + 8;
        }

        // Diamond 5
        if (i % 11 == 0)
        {
            result = result + 9;
        }
        else
        {
            result = result + 10;
        }

        i = i + 1;
    }
    return 0;
}
