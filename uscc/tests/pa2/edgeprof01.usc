// edgeprof01.usc
// Pattern: Deeply Nested Loops (4 levels)
// Tests edge profiling with high iteration count to amplify counter overhead
// ~20 edges, 120x120x120x120 = 207M iterations in innermost loop
//---------------------------------------------------------

int main()
{
    int sum = 0;
    int i = 0;
    while (i < 120)
    {
        int j = 0;
        while (j < 120)
        {
            int k = 0;
            while (k < 120)
            {
                int l = 0;
                while (l < 120)
                {
                    sum = sum + 1;
                    if (sum > 5000)
                    {
                        sum = sum - 1;
                    }
                    l = l + 1;
                }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
