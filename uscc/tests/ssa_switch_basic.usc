// ssa_switch_basic.usc
// Tests switch with 3 cases + break, variable read after switch (requires PHI at switch.end)

int main()
{
	int x = 2;
	int result = 0;

	switch (x)
	{
		case 1:
			result = 10;
			break;
		case 2:
			result = 20;
			break;
		case 3:
			result = 30;
			break;
	}

	printf("%d\n", result);

	return 0;
}
