// instcomb10.usc
// Part 2: Strength Reduction - Various powers of 2
// Tests: mul x, 2; mul x, 4; mul x, 16
// Expected: Multiplications converted to shifts
//---------------------------------------------------------

int double_it(int x)
{
	return x * 2;
}

int quad_it(int x)
{
	return x * 4;
}

int times16(int x)
{
	return x * 16;
}

int main()
{
	printf("%d %d %d\n", double_it(5), quad_it(3), times16(2));
	return 0;
}
