int main()
{
    int x = 5;
    int sum = 0;
    if (1)
    {
        sum = 5;
        ++x;
        while (x < 10)
        {
            sum = sum + x;
            ++x;
        }
    }
    printf("%d\n", sum);
    return 0;
}
