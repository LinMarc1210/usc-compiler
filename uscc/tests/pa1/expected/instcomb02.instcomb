; ModuleID = 'main'

@.str = private unnamed_addr constant [7 x i8] c"%d %d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %0 = alloca i32
  %1 = alloca i32
  store i32 5, i32* %1
  store i32 2, i32* %0
  %2 = getelementptr inbounds [7 x i8]* @.str, i32 0, i32 0
  %3 = load i32* %1
  %4 = load i32* %0
  %5 = call i32 (i8*, ...)* @printf(i8* %2, i32 %3, i32 %4)
  ret i32 0
}
