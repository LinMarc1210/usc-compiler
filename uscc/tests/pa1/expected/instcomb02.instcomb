; ModuleID = 'main'

@.str = private unnamed_addr constant [7 x i8] c"%d %d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %b.addr = alloca i32
  %a.addr = alloca i32
  store i32 5, i32* %a.addr
  store i32 2, i32* %b.addr
  %a = load i32* %a.addr
  %b = load i32* %b.addr
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([7 x i8]* @.str, i32 0, i32 0), i32 %a, i32 %b)
  ret i32 0
}
