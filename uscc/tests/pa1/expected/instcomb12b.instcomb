; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @foo(i32 %x) {
entry:
  %0 = alloca i32
  %1 = alloca i32
  %2 = alloca i32
  store i32 %x, i32* %2
  store i32 0, i32* %0
  %3 = load i32* %2
  %gt = icmp sgt i32 %3, 0
  br i1 %gt, label %if.then, label %if.else

if.then:                                          ; preds = %entry
  store i32 0, i32* %0
  br label %if.end

if.end:                                           ; preds = %if.then, %if.else
  %4 = load i32* %0
  ret i32 %4

if.else:                                          ; preds = %entry
  %5 = load i32* %2
  %add = add i32 %5, 3
  store i32 %add, i32* %1
  %6 = load i32* %1
  %7 = add i32 %5, 8
  store i32 %7, i32* %0
  br label %if.end
}

define i32 @main() {
entry:
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %call = call i32 @foo(i32 -5)
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %call)
  ret i32 0
}
