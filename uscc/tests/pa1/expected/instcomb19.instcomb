; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @compute(i32 %x) {
entry:
  %c.addr = alloca i32
  %b.addr = alloca i32
  %d.addr = alloca i32
  %a.addr = alloca i32
  %x.addr = alloca i32
  store i32 %x, i32* %x.addr
  %x1 = load i32* %x.addr
  %add = add i32 %x1, 3
  %0 = add i32 %x1, 8
  store i32 %0, i32* %a.addr
  %x3 = load i32* %x.addr
  store i32 %x3, i32* %b.addr
  %x5 = load i32* %x.addr
  store i32 %x5, i32* %c.addr
  %x6 = load i32* %x.addr
  %x7 = load i32* %x.addr
  store i32 0, i32* %d.addr
  %d = load i32* %d.addr
  %c = load i32* %c.addr
  %b = load i32* %b.addr
  %a = load i32* %a.addr
  %add8 = add i32 %a, %b
  %add9 = add i32 %add8, %c
  %add10 = add i32 %add9, %d
  ret i32 %add10
}

define i32 @main() {
entry:
  %call = call i32 @compute(i32 10)
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([4 x i8]* @.str, i32 0, i32 0), i32 %call)
  ret i32 0
}
