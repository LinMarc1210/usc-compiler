; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @foo(i32 %x) {
entry:
  %0 = alloca i32
  store i32 %x, i32* %0
  %1 = load i32* %0
  ret i32 %1
}

define i32 @main() {
entry:
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %call = call i32 @foo(i32 42)
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %call)
  ret i32 0
}
