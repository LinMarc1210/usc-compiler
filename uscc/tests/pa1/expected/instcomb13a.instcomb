; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @foo(i32 %x) {
entry:
  %z.addr = alloca i32
  %y.addr = alloca i32
  %x.addr = alloca i32
  store i32 %x, i32* %x.addr
  %x1 = load i32* %x.addr
  %gt = icmp sgt i32 %x1, 0
  br i1 %gt, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  %x2 = load i32* %x.addr
  %mul = mul i32 %x2, 3
  store i32 %mul, i32* %y.addr
  %y = load i32* %y.addr
  %0 = mul i32 %x2, 15
  store i32 %0, i32* %z.addr
  %z = load i32* %z.addr
  ret i32 %z

if.end:                                           ; preds = %entry
  ret i32 0
}

define i32 @main() {
entry:
  %call = call i32 @foo(i32 7)
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([4 x i8]* @.str, i32 0, i32 0), i32 %call)
  ret i32 0
}
