; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @zero_mul(i32 %a, i32 %b) {
entry:
  %0 = alloca i32
  %1 = alloca i32
  %2 = alloca i32
  store i32 %b, i32* %2
  %3 = alloca i32
  store i32 %a, i32* %3
  %4 = load i32* %3
  store i32 0, i32* %1
  %5 = load i32* %2
  store i32 0, i32* %0
  %6 = load i32* %0
  %7 = load i32* %1
  %add = add i32 %7, %6
  ret i32 %add
}

define i32 @main() {
entry:
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %call = call i32 @zero_mul(i32 42, i32 17)
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %call)
  ret i32 0
}
