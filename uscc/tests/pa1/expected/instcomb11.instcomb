; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @zero_mul(i32 %a, i32 %b) {
entry:
  %y.addr = alloca i32
  %x.addr = alloca i32
  %b.addr = alloca i32
  store i32 %b, i32* %b.addr
  %a.addr = alloca i32
  store i32 %a, i32* %a.addr
  %a1 = load i32* %a.addr
  store i32 0, i32* %x.addr
  %b2 = load i32* %b.addr
  store i32 0, i32* %y.addr
  %y = load i32* %y.addr
  %x = load i32* %x.addr
  %add = add i32 %x, %y
  ret i32 %add
}

define i32 @main() {
entry:
  %call = call i32 @zero_mul(i32 42, i32 17)
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([4 x i8]* @.str, i32 0, i32 0), i32 %call)
  ret i32 0
}
