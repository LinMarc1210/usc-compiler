; ModuleID = 'main'

@.str = private unnamed_addr constant [10 x i8] c"%d %d %d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %c.addr = alloca i32
  %b.addr = alloca i32
  %a.addr = alloca i32
  store i32 8, i32* %a.addr
  store i32 7, i32* %b.addr
  store i32 20, i32* %c.addr
  %a = load i32* %a.addr
  %b = load i32* %b.addr
  %c = load i32* %c.addr
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([10 x i8]* @.str, i32 0, i32 0), i32 %a, i32 %b, i32 %c)
  ret i32 0
}
