; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @compute(i32 %x) {
entry:
  %0 = alloca i32
  %1 = alloca i32
  %2 = alloca i32
  %3 = alloca i32
  %4 = alloca i32
  store i32 %x, i32* %4
  store i32 15, i32* %3
  %5 = load i32* %4
  store i32 %5, i32* %1
  %6 = load i32* %4
  store i32 %6, i32* %0
  %7 = load i32* %4
  %8 = shl i32 %7, 3
  store i32 %8, i32* %2
  %9 = load i32* %2
  %10 = load i32* %0
  %11 = load i32* %1
  %12 = load i32* %3
  %add3 = add i32 %12, %11
  %add4 = add i32 %add3, %10
  %add5 = add i32 %add4, %9
  ret i32 %add5
}

define i32 @main() {
entry:
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %call = call i32 @compute(i32 3)
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %call)
  ret i32 0
}
