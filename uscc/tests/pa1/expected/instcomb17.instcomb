; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @foo(i32 %x) {
entry:
  %z.addr = alloca i32
  %y.addr = alloca i32
  %x.addr = alloca i32
  store i32 %x, i32* %x.addr
  %x1 = load i32* %x.addr
  %x2 = load i32* %x.addr
  store i32 0, i32* %y.addr
  %y = load i32* %y.addr
  %add = add i32 %y, 10
  store i32 %add, i32* %z.addr
  %z = load i32* %z.addr
  ret i32 %z
}

define i32 @main() {
entry:
  %call = call i32 @foo(i32 999)
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([4 x i8]* @.str, i32 0, i32 0), i32 %call)
  ret i32 0
}
