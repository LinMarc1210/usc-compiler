; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @foo(i32 %x) {
entry:
  %0 = alloca i32
  %1 = alloca i32
  %2 = alloca i32
  store i32 %x, i32* %2
  %3 = load i32* %2
  %4 = load i32* %2
  store i32 0, i32* %1
  %5 = load i32* %1
  %add = add i32 %5, 10
  store i32 %add, i32* %0
  %6 = load i32* %0
  ret i32 %6
}

define i32 @main() {
entry:
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %call = call i32 @foo(i32 999)
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %call)
  ret i32 0
}
