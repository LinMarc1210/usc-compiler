; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @compute(i32 %a, i32 %b, i32 %c) {
entry:
  %z.addr = alloca i32
  %y.addr = alloca i32
  %x.addr = alloca i32
  %c.addr = alloca i32
  store i32 %c, i32* %c.addr
  %b.addr = alloca i32
  store i32 %b, i32* %b.addr
  %a.addr = alloca i32
  store i32 %a, i32* %a.addr
  %a1 = load i32* %a.addr
  store i32 %a1, i32* %x.addr
  %b2 = load i32* %b.addr
  store i32 %b2, i32* %y.addr
  %c3 = load i32* %c.addr
  store i32 %c3, i32* %z.addr
  %z = load i32* %z.addr
  %y = load i32* %y.addr
  %x = load i32* %x.addr
  %add4 = add i32 %x, %y
  %add5 = add i32 %add4, %z
  ret i32 %add5
}

define i32 @main() {
entry:
  %call = call i32 @compute(i32 10, i32 20, i32 30)
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([4 x i8]* @.str, i32 0, i32 0), i32 %call)
  ret i32 0
}
