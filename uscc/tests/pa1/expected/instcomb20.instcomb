; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @optimize_all(i32 %x, i32 %y) {
entry:
  %l2.addr = alloca i32
  %x.addr = alloca i32
  store i32 %x, i32* %x.addr
  %s1.addr = alloca i32
  %y.addr = alloca i32
  store i32 %y, i32* %y.addr
  %c1.addr = alloca i32
  %same.addr = alloca i32
  %s2.addr = alloca i32
  %c2.addr = alloca i32
  %r1.addr = alloca i32
  %i1.addr = alloca i32
  %i2.addr = alloca i32
  %i3.addr = alloca i32
  %z1.addr = alloca i32
  %r2.addr = alloca i32
  %l1.addr = alloca i32
  store i32 42, i32* %c1.addr
  store i32 20, i32* %c2.addr
  %x1 = load i32* %x.addr
  store i32 %x1, i32* %i1.addr
  %y2 = load i32* %y.addr
  store i32 %y2, i32* %i2.addr
  %x3 = load i32* %x.addr
  store i32 %x3, i32* %i3.addr
  %y4 = load i32* %y.addr
  store i32 0, i32* %z1.addr
  %x6 = load i32* %x.addr
  %0 = shl i32 %x6, 2
  store i32 %0, i32* %s1.addr
  %y8 = load i32* %y.addr
  %1 = shl i32 %y8, 3
  store i32 %1, i32* %s2.addr
  %x10 = load i32* %x.addr
  %add11 = add i32 %x10, 2
  %2 = add i32 %x10, 5
  store i32 %2, i32* %r1.addr
  %y13 = load i32* %y.addr
  %3 = shl i32 %y13, 1
  %4 = shl i32 %3, 2
  store i32 %4, i32* %r2.addr
  %x16 = load i32* %x.addr
  store i32 %x16, i32* %l1.addr
  %y18 = load i32* %y.addr
  store i32 %y18, i32* %l2.addr
  %x20 = load i32* %x.addr
  %x21 = load i32* %x.addr
  store i32 0, i32* %same.addr
  %same = load i32* %same.addr
  %l2 = load i32* %l2.addr
  %l1 = load i32* %l1.addr
  %r2 = load i32* %r2.addr
  %r1 = load i32* %r1.addr
  %s2 = load i32* %s2.addr
  %s1 = load i32* %s1.addr
  %z1 = load i32* %z1.addr
  %i3 = load i32* %i3.addr
  %i2 = load i32* %i2.addr
  %i1 = load i32* %i1.addr
  %c2 = load i32* %c2.addr
  %c1 = load i32* %c1.addr
  %add23 = add i32 %c1, %c2
  %add24 = add i32 %add23, %i1
  %add25 = add i32 %add24, %i2
  %add26 = add i32 %add25, %i3
  %add27 = add i32 %add26, %z1
  %add28 = add i32 %add27, %s1
  %add29 = add i32 %add28, %s2
  %add30 = add i32 %add29, %r1
  %add31 = add i32 %add30, %r2
  %add32 = add i32 %add31, %l1
  %add33 = add i32 %add32, %l2
  %add34 = add i32 %add33, %same
  ret i32 %add34
}

define i32 @main() {
entry:
  %call = call i32 @optimize_all(i32 5, i32 3)
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([4 x i8]* @.str, i32 0, i32 0), i32 %call)
  ret i32 0
}
