int main()
{
    int x = 0;
    int sum = 0;
    while (x < 10)
    {
        x = x + 1;
        if (x == 2)
        {
            continue;
        }
        if (x == 7)
        {
            break;
        }
        sum = sum + x;
    }
    return sum;
}
