; ModuleID = 'main'

@.str = private unnamed_addr constant [7 x i8] c"%d %d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @foo(i32 %x) {
entry:
  %x.addr = alloca i32
  store i32 %x, i32* %x.addr
  %x1 = load i32* %x.addr
  ret i32 %x1
}

define i32 @bar(i32 %x) {
entry:
  %x.addr = alloca i32
  store i32 %x, i32* %x.addr
  %x1 = load i32* %x.addr
  ret i32 %x1
}

define i32 @main() {
entry:
  %call = call i32 @foo(i32 42)
  %call1 = call i32 @bar(i32 17)
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([7 x i8]* @.str, i32 0, i32 0), i32 %call, i32 %call1)
  ret i32 0
}
