; ModuleID = 'main'

@.str = private unnamed_addr constant [10 x i8] c"%d %d %d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @double_it(i32 %x) {
entry:
  %0 = alloca i32
  store i32 %x, i32* %0
  %1 = load i32* %0
  %2 = shl i32 %1, 1
  ret i32 %2
}

define i32 @quad_it(i32 %x) {
entry:
  %0 = alloca i32
  store i32 %x, i32* %0
  %1 = load i32* %0
  %2 = shl i32 %1, 2
  ret i32 %2
}

define i32 @times16(i32 %x) {
entry:
  %0 = alloca i32
  store i32 %x, i32* %0
  %1 = load i32* %0
  %2 = shl i32 %1, 4
  ret i32 %2
}

define i32 @main() {
entry:
  %0 = getelementptr inbounds [10 x i8]* @.str, i32 0, i32 0
  %call = call i32 @double_it(i32 5)
  %call1 = call i32 @quad_it(i32 3)
  %call2 = call i32 @times16(i32 2)
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %call, i32 %call1, i32 %call2)
  ret i32 0
}
