int main()
{
    int x = 0;
    int y = 0;
    int sum = 0;
    ++x;
    while (x < 5)
    {
        sum = sum + x;
        ++x;
    }
    if (1)
    {
        sum = 0;
        ++y;
        while (y < 3)
        {
            sum = sum + y;
            ++y;
        }
    }
    printf("%d\n", sum);
    return 0;
}
