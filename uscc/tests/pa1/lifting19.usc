// lifting19.usc
// Part 5: Switch-Case - Switch with fall-through
// Tests: ASTSwitchStmt, ASTCaseStmt fall-through toCode()
//---------------------------------------------------------

int main()
{
	int x = 1;
	int result = 0;
	switch (x)
	{
		case 1:
		case 2:
			result = 12;
			break;
		case 3:
			result = 3;
			break;
		default:
			result = 0;
	}
	return result;
}
