// instcomb19.usc
// Comprehensive: Part 3 + Part 4 + Part 5
// Tests: Reassociation, LHS identity, same operand
// Expected: All optimizations applied
//---------------------------------------------------------

int compute(int x)
{
	int a = (x + 3) + 5;
	int b = 0 + x;
	int c = 1 * x;
	int d = x - x;
	return a + b + c + d;
}

int main()
{
	printf("%d\n", compute(10));
	return 0;
}
