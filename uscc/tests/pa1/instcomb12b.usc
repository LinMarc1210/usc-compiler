// instcomb12b.usc
// Part 3: Reassociation - Addition (Store in if.else)
// Tests: (add (add x, C1), C2) -> add x, (C1+C2)
// Expected: (x + 3) + 5 -> x + 8
// Scenario: Store y in IF.ELSE block only, load y in same block (no PHI needed)
//---------------------------------------------------------

int foo(int x)
{
	int y;
	int z;
	z = 0;
	if (x > 0) {
		z = 0;
	} else {
		y = x + 3;
		z = y + 5;
	}
	return z;
}

int main()
{
	printf("%d\n", foo(-5));
	return 0;
}
