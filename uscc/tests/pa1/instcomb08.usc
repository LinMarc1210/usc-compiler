// instcomb08.usc
// Part 2: Strength Reduction - Multiply by power of 2
// Tests: mul x, 2 -> shl x, 1; mul x, 8 -> shl x, 3
// Expected: mul replaced by shl in optimized IR
//---------------------------------------------------------

int double_it(int x)
{
	return x * 2;
}

int times_eight(int x)
{
	return x * 8;
}

int main()
{
	printf("%d %d\n", double_it(5), times_eight(3));
	return 0;
}
