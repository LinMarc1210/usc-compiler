// lifting15.usc
// Part 4: Do-While Loop - Nested do-while
// Tests: ASTDoWhileStmt nested toCode()
//---------------------------------------------------------

int main()
{
	int x = 0;
	int y;
	do
	{
		y = 0;
		do
		{
			y = y + 1;
		}
		while (y < 2);
		x = x + 1;
	}
	while (x < 2);
	return x;
}
