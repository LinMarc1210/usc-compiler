// instcomb11.usc
// Part 2: Zero Absorbing - Multiple patterns
// Tests: x * 0 in various contexts
// Expected: All multiplications by zero become zero
//---------------------------------------------------------

int zero_mul(int a, int b)
{
	int x = a * 0;
	int y = 0 * b;
	return x + y;
}

int main()
{
	printf("%d\n", zero_mul(42, 17));
	return 0;
}
