// peeltest03.usc
// Loop Peeling Test: Nested Peelable Loops
// Tests: Both outer and inner loops are peelable
//---------------------------------------------------------

int main()
{
	int i = 0;
	int j;
	int sum = 0;
	while (i < 3)
	{
		j = 0;
		while (j < 2)
		{
			sum = sum + 1;
			++j;
		}
		++i;
	}
	printf("%d\n", sum);
	return 0;
}
