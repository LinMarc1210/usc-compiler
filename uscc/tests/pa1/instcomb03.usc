// instcomb03.usc
// Part 1: Constant Folding - Chained operations
// Tests: Multiple constant folds in expression chains
// Expected: 2+3+4 -> 9, 10-2-3 -> 5
//---------------------------------------------------------

int main()
{
	int a = 2 + 3 + 4;
	int b = 10 - 2 - 3;
	printf("%d %d\n", a, b);
	return 0;
}
