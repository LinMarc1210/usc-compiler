// instcomb12.usc
// Part 3: Reassociation - Addition (Multi-Block)
// Tests: (add (add x, C1), C2) -> add x, (C1+C2)
// Expected: (x + 3) + 5 -> x + 8
// Scenario: Store y in ENTRY block only, load y in if.end (no PHI needed)
//---------------------------------------------------------

int foo(int x)
{
	int y;
	int z;
	y = x + 3;
	if (x > 0) {
		int dummy;
		dummy = 1;
	}
	z = y + 5;
	return z;
}

int main()
{
	printf("%d\n", foo(10));
	return 0;
}
