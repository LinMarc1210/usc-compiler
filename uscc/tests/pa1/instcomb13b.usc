// instcomb13b.usc
// Part 3: Reassociation - Multiplication (Store in if.else)
// Tests: (mul (mul x, C1), C2) -> mul x, (C1*C2)
// Expected: (x * 3) * 5 -> x * 15
// Scenario: Store y in IF.ELSE block only, load y in same block (no PHI needed)
// Note: Using non-power-of-2 constants to avoid strength reduction interference
//---------------------------------------------------------

int foo(int x)
{
	int y;
	int z;
	z = 0;
	if (x > 0) {
		z = 0;
	} else {
		y = x * 3;
		z = y * 5;
	}
	return z;
}

int main()
{
	printf("%d\n", foo(-3));
	return 0;
}
