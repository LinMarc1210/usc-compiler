// peeltest02.usc
// Loop Peeling Test: Non-Peelable Loop (Variable Redefined)
// Tests: Loop where condition variable is modified before loop
//---------------------------------------------------------

int main()
{
	int x = 5;
	int sum = 0;
	++x;
	while (x < 10)
	{
		sum = sum + x;
		++x;
	}
	printf("%d\n", sum);
	return 0;
}
