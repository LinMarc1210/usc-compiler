// instcomb13a.usc
// Part 3: Reassociation - Multiplication (Store in if.then)
// Tests: (mul (mul x, C1), C2) -> mul x, (C1*C2)
// Expected: (x * 3) * 5 -> x * 15
// Scenario: Store y in IF.THEN block only, load y in same block (no PHI needed)
// Note: Using non-power-of-2 constants to avoid strength reduction interference
//---------------------------------------------------------

int foo(int x)
{
	int y;
	int z;
	if (x > 0) {
		y = x * 3;
		z = y * 5;
		return z;
	}
	return 0;
}

int main()
{
	printf("%d\n", foo(7));
	return 0;
}
