// instcomb13.usc
// Part 3: Reassociation - Multiplication (Multi-Block)
// Tests: (mul (mul x, C1), C2) -> mul x, (C1*C2)
// Expected: (x * 3) * 5 -> x * 15
// Scenario: Store y in ENTRY block only, load y in if.end (no PHI needed)
// Note: Using non-power-of-2 constants to avoid strength reduction interference
//---------------------------------------------------------

int foo(int x)
{
	int y;
	int z;
	y = x * 3;
	if (x > 0) {
		int dummy;
		dummy = 1;
	}
	z = y * 5;
	return z;
}

int main()
{
	printf("%d\n", foo(7));
	return 0;
}
