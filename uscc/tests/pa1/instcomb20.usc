// instcomb20.usc
// Comprehensive: Full Part 1 optimization pipeline
// Tests: All Part 1 optimizations together
// Expected: Maximum optimization applied
//---------------------------------------------------------

int optimize_all(int x, int y)
{
	// Part 1: Constant folding
	int c1 = 6 * 7;
	int c2 = 100 / 5;

	// Part 2: Identity and zero patterns (RHS)
	int i1 = x + 0;
	int i2 = y - 0;
	int i3 = x * 1;
	int z1 = y * 0;

	// Part 2: Strength reduction
	int s1 = x * 4;
	int s2 = y * 8;

	// Part 3: Reassociation
	int r1 = (x + 2) + 3;
	int r2 = (y * 2) * 4;

	// Part 4: LHS identity
	int l1 = 0 + x;
	int l2 = 1 * y;

	// Part 5: Same operand
	int same = x - x;

	return c1 + c2 + i1 + i2 + i3 + z1 + s1 + s2 + r1 + r2 + l1 + l2 + same;
}

int main()
{
	printf("%d\n", optimize_all(5, 3));
	return 0;
}
