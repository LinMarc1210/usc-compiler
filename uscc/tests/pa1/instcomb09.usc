// instcomb09.usc
// Part 2: Identity Patterns - Multiple variables
// Tests: Multiple identity optimizations in sequence
// Expected: All identity operations eliminated
//---------------------------------------------------------

int compute(int a, int b, int c)
{
	int x = a + 0;
	int y = b - 0;
	int z = c * 1;
	return x + y + z;
}

int main()
{
	printf("%d\n", compute(10, 20, 30));
	return 0;
}
