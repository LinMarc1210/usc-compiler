// instcomb01.usc
// Part 1: Constant Folding - Basic arithmetic
// Tests: add C1, C2; sub C1, C2; mul C1, C2
// Expected: Constants folded at compile time
//---------------------------------------------------------

int main()
{
	int a = 3 + 5;
	int b = 10 - 3;
	int c = 4 * 5;
	printf("%d %d %d\n", a, b, c);
	return 0;
}
