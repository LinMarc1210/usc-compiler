// instcomb14.usc
// Part 4: LHS Constant Identity
// Tests: 0 + x -> x; 1 * x -> x
// Expected: No add with 0 or mul with 1 in optimized IR
//---------------------------------------------------------

int foo(int x)
{
	return 0 + x;
}

int bar(int x)
{
	return 1 * x;
}

int main()
{
	printf("%d %d\n", foo(42), bar(17));
	return 0;
}
