// peeltest01.usc
// Loop Peeling Test: Simple Peelable Loop
// Tests: Basic peelable while loop with guaranteed first iteration
//---------------------------------------------------------

int main()
{
	int x = 5;
	int sum = 0;
	while (x < 10)
	{
		sum = sum + x;
		++x;
	}
	printf("%d\n", sum);
	return 0;
}
