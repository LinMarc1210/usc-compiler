// lifting11.usc
// Part 3: For Loop - For loop with continue
// Tests: ASTForStmt with ASTContinueStmt toCode()
//---------------------------------------------------------

int main()
{
	int sum = 0;
	int i;
	for (i = 0; i < 5; ++i)
	{
		if (i == 2)
		{
			continue;
		}
		sum = sum + i;
	}
	return sum;
}
