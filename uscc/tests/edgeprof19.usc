// edgeprof19.usc
// Pattern: Worst-Case CFG (maximum edges)
// Stress test for profiling with many branches
// ~50 edges, 200000000 iterations
//---------------------------------------------------------

int main()
{
    int a = 1;
    int b = 2;
    int c = 3;
    int d = 4;
    int iter = 0;

    while (iter < 200000000)
    {
        // First nested chain
        if (a > 0)
        {
            if (b > 0)
            {
                if (c > 0)
                {
                    if (d > 0)
                    {
                        a = a + 1;
                    }
                    else
                    {
                        a = a - 1;
                    }
                }
                else
                {
                    b = b + 1;
                }
            }
            else
            {
                c = c + 1;
            }
        }
        else
        {
            d = d + 1;
        }

        // Second nested chain with modulo checks
        if (a % 2 == 0)
        {
            if (b % 2 == 0)
            {
                if (c % 2 == 0)
                {
                    if (d % 2 == 0)
                    {
                        a = b;
                    }
                    else
                    {
                        b = c;
                    }
                }
                else
                {
                    c = d;
                }
            }
            else
            {
                d = a;
            }
        }
        else
        {
            a = 1;
        }

        // Third nested chain with range checks
        if (a < 100)
        {
            if (b < 100)
            {
                if (c < 100)
                {
                    d = d + 1;
                }
                else
                {
                    c = 1;
                }
            }
            else
            {
                b = 1;
            }
        }
        else
        {
            a = 1;
        }

        iter = iter + 1;
    }
    return 0;
}
