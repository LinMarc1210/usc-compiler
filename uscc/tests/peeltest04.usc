// peeltest04.usc
// Loop Peeling Test: Sequential Peelable Loops
// Tests: Two sequential while loops, both peelable
//---------------------------------------------------------

int main()
{
	int x = 0;
	int sum = 0;
	while (x < 3)
	{
		sum = sum + x;
		++x;
	}
	while (x < 6)
	{
		sum = sum + x;
		++x;
	}
	printf("%d\n", sum);
	return 0;
}
