Program:
---Function: int main
------CompoundStmt:
---------Decl: int x
------------ConstantExpr: 5
---------Decl: int result
------------ConstantExpr: 0
---------SwitchStmt
------------IdentExpr: x
------------CaseStmt
---------------ConstantExpr: 1
---------------AssignStmt: result
------------------ConstantExpr: 10
------------CaseStmt
---------------ConstantExpr: 2
---------------AssignStmt: result
------------------ConstantExpr: 20
------------DefaultStmt
---------------AssignStmt: result
------------------ConstantExpr: 99
---------ReturnStmt:
------------IdentExpr: result
int main()
{
    int x = 5;
    int result = 0;
    switch (x)
    {
        case 1:
            result = 10;
        case 2:
            result = 20;
        default:
            result = 99;
    }
    return result;
}
