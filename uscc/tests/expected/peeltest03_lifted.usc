int main()
{
    int i = 0;
    int j;
    int sum = 0;
    if (1)
    {
        j = 0;
        while (j < 2)
        {
            sum = sum + 1;
            ++j;
        }
        ++i;
        while (i < 3)
        {
            j = 0;
            while (j < 2)
            {
                sum = sum + 1;
                ++j;
            }
            ++i;
        }
    }
    printf("%d\n", sum);
    return 0;
}
