; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [4 x i32], align 8
  %0 = getelementptr inbounds [4 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 2, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 2
  store i32 0, i32* %3
  %4 = getelementptr inbounds i32* %0, i32 3
  store i32 0, i32* %4
  %5 = getelementptr inbounds i32* %0, i32 0
  %6 = load i32* %5
  %7 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %5, %7
  %8 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp20 = icmp eq i32* %5, %8
  br label %alias.header

alias.header:                                     ; preds = %if.end10, %entry
  %.alloca.0 = phi i32 [ %6, %entry ], [ %.alloca.0., %if.end10 ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.3, %if.end10 ]
  %Phi219 = phi i32 [ 0, %entry ], [ %add, %if.end10 ]
  %Phi18 = phi i32 [ 0, %entry ], [ %add14, %if.end10 ]
  %neg.alias = icmp eq i1 %alias.0, false
  %9 = load i32* %5
  %.alloca.0. = select i1 %neg.alias, i32 %.alloca.0, i32 %9
  %alias.0. = select i1 %neg.alias, i1 %alias.0, i1 false
  %add = add i32 %Phi219, %.alloca.0.
  %div = sdiv i32 %Phi18, 20
  %mul = mul i32 %div, 20
  %sub = sub i32 %Phi18, %mul
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

while.end:                                        ; preds = %if.end10
  %Phi2.lcssa = phi i32 [ %add, %if.end10 ]
  %10 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %11 = call i32 (i8*, ...)* @printf(i8* %10, i32 %Phi2.lcssa)
  ret i32 0

if.then:                                          ; preds = %alias.header
  %add3 = add i32 %Phi18, 1
  store i32 %add3, i32* %7
  br label %if.end

if.end:                                           ; preds = %if.then, %alias.header
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.0., %alias.header ]
  %div5 = sdiv i32 %Phi18, 37
  %mul6 = mul i32 %div5, 37
  %sub7 = sub i32 %Phi18, %mul6
  %eq8 = icmp eq i32 %sub7, 0
  br i1 %eq8, label %if.then9, label %if.end10, !prof !1

if.then9:                                         ; preds = %if.end
  %mul11 = mul i32 %Phi18, 3
  store i32 %mul11, i32* %8
  br label %if.end10

if.end10:                                         ; preds = %if.then9, %if.end
  %alias.3 = phi i1 [ %alias.cmp20, %if.then9 ], [ %alias.2, %if.end ]
  %add14 = add i32 %Phi18, 1
  %lt = icmp slt i32 %add14, 80
  br i1 %lt, label %alias.header, label %while.end, !prof !2
}

!0 = metadata !{metadata !"branch_weights", i32 4, i32 76}
!1 = metadata !{metadata !"branch_weights", i32 3, i32 77}
!2 = metadata !{metadata !"branch_weights", i32 80, i32 1}
