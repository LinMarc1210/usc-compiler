; ModuleID = 'main'

@.str = private unnamed_addr constant [10 x i8] c"%d %d %d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %0 = alloca i32
  %1 = alloca i32
  %2 = alloca i32
  store i32 8, i32* %2
  store i32 7, i32* %1
  store i32 20, i32* %0
  %3 = getelementptr inbounds [10 x i8]* @.str, i32 0, i32 0
  %4 = load i32* %2
  %5 = load i32* %1
  %6 = load i32* %0
  %7 = call i32 (i8*, ...)* @printf(i8* %3, i32 %4, i32 %5, i32 %6)
  ret i32 0
}
