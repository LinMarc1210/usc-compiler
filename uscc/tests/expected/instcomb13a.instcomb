; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @foo(i32 %x) {
entry:
  %0 = alloca i32
  %1 = alloca i32
  %2 = alloca i32
  store i32 %x, i32* %2
  %3 = load i32* %2
  %gt = icmp sgt i32 %3, 0
  br i1 %gt, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  %4 = load i32* %2
  %mul = mul i32 %4, 3
  store i32 %mul, i32* %1
  %5 = load i32* %1
  %6 = mul i32 %4, 15
  store i32 %6, i32* %0
  %7 = load i32* %0
  ret i32 %7

if.end:                                           ; preds = %entry
  ret i32 0
}

define i32 @main() {
entry:
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %call = call i32 @foo(i32 7)
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %call)
  ret i32 0
}
