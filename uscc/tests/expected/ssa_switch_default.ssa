; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  switch i32 5, label %switch.default [
    i32 1, label %switch.case
    i32 2, label %switch.case1
  ]

switch.end:                                       ; preds = %switch.default, %switch.case1, %switch.case
  %Phi = phi i32 [ 99, %switch.default ], [ 20, %switch.case1 ], [ 10, %switch.case ]
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %Phi)
  ret i32 0

switch.case:                                      ; preds = %entry
  br label %switch.end

switch.case1:                                     ; preds = %entry
  br label %switch.end

switch.default:                                   ; preds = %entry
  br label %switch.end
}
