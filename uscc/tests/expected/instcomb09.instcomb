; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @compute(i32 %a, i32 %b, i32 %c) {
entry:
  %0 = alloca i32
  %1 = alloca i32
  %2 = alloca i32
  %3 = alloca i32
  store i32 %c, i32* %3
  %4 = alloca i32
  store i32 %b, i32* %4
  %5 = alloca i32
  store i32 %a, i32* %5
  %6 = load i32* %5
  store i32 %6, i32* %2
  %7 = load i32* %4
  store i32 %7, i32* %1
  %8 = load i32* %3
  store i32 %8, i32* %0
  %9 = load i32* %0
  %10 = load i32* %1
  %11 = load i32* %2
  %add1 = add i32 %11, %10
  %add2 = add i32 %add1, %9
  ret i32 %add2
}

define i32 @main() {
entry:
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %call = call i32 @compute(i32 10, i32 20, i32 30)
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %call)
  ret i32 0
}
