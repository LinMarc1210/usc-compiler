; ModuleID = 'main'

@.str = private unnamed_addr constant [12 x i8] c"x=%d, y=%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %temp.addr = alloca i32
  %y.addr = alloca i32
  %x.addr = alloca i32
  %c.addr = alloca i32
  %b.addr = alloca i32
  %a.addr = alloca i32
  store i32 2, i32* %a.addr
  store i32 3, i32* %b.addr
  store i32 4, i32* %c.addr
  %b = load i32* %b.addr
  %a = load i32* %a.addr
  %mul = mul i32 %a, %b
  store i32 %mul, i32* %temp.addr
  %c = load i32* %c.addr
  %temp = load i32* %temp.addr
  %add = add i32 %temp, %c
  store i32 %add, i32* %x.addr
  %c1 = load i32* %c.addr
  %sub = sub i32 %mul, %c1
  store i32 %sub, i32* %y.addr
  %x = load i32* %x.addr
  %y = load i32* %y.addr
  %0 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([12 x i8]* @.str, i32 0, i32 0), i32 %x, i32 %y)
  ret i32 0
}
