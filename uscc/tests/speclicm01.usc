// fplicm01.usc
// Canonical FPLICM example: arr[0] is read on every iteration, but only
// rewritten on an infrequent path (every 16th iteration). With profile
// data, FPLICM should speculate-hoist the load of arr[0] AND the
// dependent `* 23` multiplication into the preheader via
// collectDependentChain. Mis-speculation is handled by the existing
// alias-check fix-up block.
// Expected output: 1008
int main()
{
	int arr[8];
	int i;
	int sum;
	int mod;

	arr[0] = 1;
	arr[1] = 0;
	arr[2] = 0;
	arr[3] = 0;
	arr[4] = 0;
	arr[5] = 0;
	arr[6] = 0;
	arr[7] = 0;

	i = 0;
	sum = 0;
	while (i < 64)
	{
		sum = sum + arr[0] * 23;
		mod = i - ((i / 16) * 16);
		if (mod == 0)
		{
			arr[0] = i + 1;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
