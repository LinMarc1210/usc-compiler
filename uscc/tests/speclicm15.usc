// fplicm15.usc
// Outer loop body contains an if-else (diamond CFG) with loads on the
// frequent side. The EECS 583 spec's "≥80% frequent path" logic has to
// handle multi-block body shapes, not just straight while-body → latch.
int main()
{
	int arr[2];
	int i;
	int sum;
	int tmp;

	arr[0] = 3;
	arr[1] = 0;

	i = 0;
	sum = 0;
	while (i < 40)
	{
		if (i - ((i / 3) * 3) == 0)
		{
			tmp = arr[0] + 2;
		}
		else
		{
			tmp = arr[0] * 2;
		}
		sum = sum + tmp;
		if (i - ((i / 20) * 20) == 0)
		{
			arr[0] = i + 5;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
