// fplicm10.usc
// Frequent-path load used twice in the same expression: arr[0] * arr[0].
// The dependent chain is the single mul that has the loaded value as both
// operands. collectDependentChain should accept it (both operands are the
// load itself).
int main()
{
	int arr[4];
	int i;
	int sum;

	arr[0] = 4;
	arr[1] = 0;
	arr[2] = 0;
	arr[3] = 0;

	i = 0;
	sum = 0;
	while (i < 40)
	{
		sum = sum + arr[0] * arr[0];
		if (i - ((i / 20) * 20) == 0)
		{
			arr[0] = i + 2;
		}
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
