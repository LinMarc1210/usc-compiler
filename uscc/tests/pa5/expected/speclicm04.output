; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [2 x i32], align 8
  %0 = getelementptr inbounds [2 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 4, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 0
  %4 = load i32* %3
  %mul = mul i32 %4, 7
  %add = add i32 %mul, 3
  %5 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %3, %5
  br label %alias.header

alias.header:                                     ; preds = %if.end, %entry
  %add.alloca.0 = phi i32 [ %add, %entry ], [ %add.alloca.1, %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi211 = phi i32 [ 0, %entry ], [ %add3, %if.end ]
  %Phi10 = phi i32 [ 0, %entry ], [ %add7, %if.end ]
  %neg.alias = icmp eq i1 %alias.0, false
  br i1 %neg.alias, label %while.body, label %alias.fixup

alias.fixup:                                      ; preds = %alias.header
  %6 = load i32* %3
  %7 = mul i32 %6, 7
  %8 = add i32 %7, 3
  br label %while.body

while.body:                                       ; preds = %alias.header, %alias.fixup
  %add.alloca.1 = phi i32 [ %add.alloca.0, %alias.header ], [ %8, %alias.fixup ]
  %alias.1 = phi i1 [ %alias.0, %alias.header ], [ false, %alias.fixup ]
  %add3 = add i32 %Phi211, %add.alloca.1
  %div = sdiv i32 %Phi10, 24
  %mul4 = mul i32 %div, 24
  %sub = sub i32 %Phi10, %mul4
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

while.end:                                        ; preds = %if.end
  %Phi2.lcssa = phi i32 [ %add3, %if.end ]
  %9 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %10 = call i32 (i8*, ...)* @printf(i8* %9, i32 %Phi2.lcssa)
  ret i32 0

if.then:                                          ; preds = %while.body
  %add5 = add i32 %Phi10, 1
  store i32 %add5, i32* %5
  br label %if.end

if.end:                                           ; preds = %if.then, %while.body
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.1, %while.body ]
  %add7 = add i32 %Phi10, 1
  %lt = icmp slt i32 %add7, 48
  br i1 %lt, label %alias.header, label %while.end, !prof !1
}

!0 = metadata !{metadata !"branch_weights", i32 2, i32 46}
!1 = metadata !{metadata !"branch_weights", i32 48, i32 1}
