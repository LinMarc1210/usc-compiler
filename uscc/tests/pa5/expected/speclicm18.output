; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [2 x i32], align 8
  %0 = getelementptr inbounds [2 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 5, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 0
  %4 = load i32* %3
  %mul = mul i32 %4, 3
  %5 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %3, %5
  br label %alias.header

alias.header:                                     ; preds = %if.end, %entry
  %mul.alloca.0 = phi i32 [ %mul, %entry ], [ %mul.alloca.1, %if.end ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.2, %if.end ]
  %Phi210 = phi i32 [ 0, %entry ], [ %add, %if.end ]
  %Phi9 = phi i32 [ 0, %entry ], [ %add6, %if.end ]
  %neg.alias = icmp eq i1 %alias.0, false
  br i1 %neg.alias, label %for.body, label %alias.fixup

alias.fixup:                                      ; preds = %alias.header
  %6 = load i32* %3
  %7 = mul i32 %6, 3
  br label %for.body

for.body:                                         ; preds = %alias.header, %alias.fixup
  %mul.alloca.1 = phi i32 [ %mul.alloca.0, %alias.header ], [ %7, %alias.fixup ]
  %alias.1 = phi i1 [ %alias.0, %alias.header ], [ false, %alias.fixup ]
  %add = add i32 %Phi210, %mul.alloca.1
  %div = sdiv i32 %Phi9, 50
  %mul3 = mul i32 %div, 50
  %sub = sub i32 %Phi9, %mul3
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

for.end:                                          ; preds = %if.end
  %Phi2.lcssa = phi i32 [ %add, %if.end ]
  %8 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %9 = call i32 (i8*, ...)* @printf(i8* %8, i32 %Phi2.lcssa)
  ret i32 0

if.then:                                          ; preds = %for.body
  %add4 = add i32 %Phi9, 1
  store i32 %add4, i32* %5
  br label %if.end

if.end:                                           ; preds = %if.then, %for.body
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.1, %for.body ]
  %add6 = add i32 %Phi9, 1
  %lt = icmp slt i32 %add6, 200
  br i1 %lt, label %alias.header, label %for.end, !prof !1
}

!0 = metadata !{metadata !"branch_weights", i32 4, i32 196}
!1 = metadata !{metadata !"branch_weights", i32 200, i32 1}
