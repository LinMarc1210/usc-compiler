; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [4 x i32], align 8
  %0 = getelementptr inbounds [4 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 3, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 0, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 2
  store i32 0, i32* %3
  %4 = getelementptr inbounds i32* %0, i32 3
  store i32 0, i32* %4
  %5 = getelementptr inbounds i32* %0, i32 0
  %6 = load i32* %5
  %7 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp = icmp eq i32* %5, %7
  %8 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp27 = icmp eq i32* %5, %8
  %9 = getelementptr inbounds i32* %0, i32 0
  %alias.cmp28 = icmp eq i32* %5, %9
  br label %alias.header

alias.header:                                     ; preds = %if.end17, %entry
  %.alloca.0 = phi i32 [ %6, %entry ], [ %.alloca.0., %if.end17 ]
  %alias.0 = phi i1 [ false, %entry ], [ %alias.4, %if.end17 ]
  %Phi226 = phi i32 [ 0, %entry ], [ %add, %if.end17 ]
  %Phi25 = phi i32 [ 0, %entry ], [ %add20, %if.end17 ]
  %neg.alias = icmp eq i1 %alias.0, false
  %10 = load i32* %5
  %.alloca.0. = select i1 %neg.alias, i32 %.alloca.0, i32 %10
  %alias.0. = select i1 %neg.alias, i1 %alias.0, i1 false
  %add = add i32 %Phi226, %.alloca.0.
  %div = sdiv i32 %Phi25, 17
  %mul = mul i32 %div, 17
  %sub = sub i32 %Phi25, %mul
  %eq = icmp eq i32 %sub, 0
  br i1 %eq, label %if.then, label %if.end, !prof !0

while.end:                                        ; preds = %if.end17
  %Phi2.lcssa = phi i32 [ %add, %if.end17 ]
  %11 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %12 = call i32 (i8*, ...)* @printf(i8* %11, i32 %Phi2.lcssa)
  ret i32 0

if.then:                                          ; preds = %alias.header
  store i32 5, i32* %7
  br label %if.end

if.end:                                           ; preds = %if.then, %alias.header
  %alias.2 = phi i1 [ %alias.cmp, %if.then ], [ %alias.0., %alias.header ]
  %div4 = sdiv i32 %Phi25, 23
  %mul5 = mul i32 %div4, 23
  %sub6 = sub i32 %Phi25, %mul5
  %eq7 = icmp eq i32 %sub6, 0
  br i1 %eq7, label %if.then8, label %if.end9, !prof !1

if.then8:                                         ; preds = %if.end
  store i32 7, i32* %8
  br label %if.end9

if.end9:                                          ; preds = %if.then8, %if.end
  %alias.3 = phi i1 [ %alias.cmp27, %if.then8 ], [ %alias.2, %if.end ]
  %div12 = sdiv i32 %Phi25, 41
  %mul13 = mul i32 %div12, 41
  %sub14 = sub i32 %Phi25, %mul13
  %eq15 = icmp eq i32 %sub14, 0
  br i1 %eq15, label %if.then16, label %if.end17, !prof !2

if.then16:                                        ; preds = %if.end9
  store i32 11, i32* %9
  br label %if.end17

if.end17:                                         ; preds = %if.then16, %if.end9
  %alias.4 = phi i1 [ %alias.cmp28, %if.then16 ], [ %alias.3, %if.end9 ]
  %add20 = add i32 %Phi25, 1
  %lt = icmp slt i32 %add20, 120
  br i1 %lt, label %alias.header, label %while.end, !prof !3
}

!0 = metadata !{metadata !"branch_weights", i32 8, i32 112}
!1 = metadata !{metadata !"branch_weights", i32 6, i32 114}
!2 = metadata !{metadata !"branch_weights", i32 3, i32 117}
!3 = metadata !{metadata !"branch_weights", i32 120, i32 1}
