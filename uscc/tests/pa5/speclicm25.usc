// fplicm25.usc
// Two independent loops in the same function: first loop has an
// almost-invariant load, second loop is plain. Verifies the pass
// processes loops independently.
int main()
{
	int arr[2];
	int i;
	int sum1;
	int sum2;

	arr[0] = 4;
	arr[1] = 0;

	sum1 = 0;
	for (i = 0; i < 30; i = i + 1)
	{
		sum1 = sum1 + arr[0];
		if (i - ((i / 15) * 15) == 0)
		{
			arr[0] = i + 1;
		}
	}

	sum2 = 0;
	for (i = 0; i < 10; i = i + 1)
	{
		sum2 = sum2 + i;
	}

	printf("%d\n", sum1 + sum2);
	return 0;
}
