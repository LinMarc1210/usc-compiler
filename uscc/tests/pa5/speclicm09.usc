// fplicm09.usc
// Infrequent store with a dependent chain: load + mul + add, where the
// chain feeds into a DIFFERENT address (not the one being loaded). All
// dependents are hoistable; the infrequent store does a plain constant
// write so the RMW check lets everything through.
int main()
{
	int arr[4];
	int out[64];
	int i;
	int sum;

	arr[0] = 5;
	arr[1] = 0;
	arr[2] = 0;
	arr[3] = 0;

	i = 0;
	sum = 0;
	while (i < 32)
	{
		out[i] = arr[0] * 3 + 1;
		if (i - ((i / 16) * 16) == 0)
		{
			arr[0] = i + 7;
		}
		i = i + 1;
	}

	i = 0;
	while (i < 32)
	{
		sum = sum + out[i];
		i = i + 1;
	}

	printf("%d\n", sum);
	return 0;
}
