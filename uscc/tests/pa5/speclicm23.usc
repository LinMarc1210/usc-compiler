// fplicm23.usc
// Zero-trip count — loop guarded by an outer condition that happens to be
// false. Verifies we don't crash when the loop body never executes.
int main()
{
	int arr[2];
	int i;
	int sum;
	int cond;

	arr[0] = 9;
	arr[1] = 0;

	sum = 0;
	cond = 0;
	if (cond)
	{
		for (i = 0; i < 10; i = i + 1)
		{
			sum = sum + arr[0];
			if (i - ((i / 5) * 5) == 0)
			{
				arr[0] = i + 1;
			}
		}
	}
	else
	{
		sum = 42;
	}

	printf("%d\n", sum);
	return 0;
}
