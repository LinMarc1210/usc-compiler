// fplicm21.usc
// Negative / regression: half-and-half branching (50/50) via i%2. No
// frequent path exists under the ≥80% threshold; profile filter should
// decline speculation but plain alias-based FPLICM still works.
int main()
{
	int arr[2];
	int i;
	int sum;

	arr[0] = 2;
	arr[1] = 0;

	sum = 0;
	for (i = 0; i < 20; i = i + 1)
	{
		sum = sum + arr[0];
		if (i - ((i / 2) * 2) == 0)
		{
			arr[0] = i + 1;
		}
	}

	printf("%d\n", sum);
	return 0;
}
