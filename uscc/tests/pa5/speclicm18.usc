// fplicm18.usc
// Large number of iterations (200), small dependent chain. Verifies
// correctness scales.
int main()
{
	int arr[2];
	int i;
	int sum;

	arr[0] = 5;
	arr[1] = 0;

	sum = 0;
	for (i = 0; i < 200; i = i + 1)
	{
		sum = sum + arr[0] * 3;
		if (i - ((i / 50) * 50) == 0)
		{
			arr[0] = i + 1;
		}
	}

	printf("%d\n", sum);
	return 0;
}
