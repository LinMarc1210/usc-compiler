// fplicm24.usc
// Deep dependent chain + high trip count. Verifies numeric correctness at
// scale: `arr[0]` through five arithmetic transforms per iteration.
int main()
{
	int arr[2];
	int i;
	int acc;

	arr[0] = 3;
	arr[1] = 0;

	acc = 0;
	for (i = 0; i < 100; i = i + 1)
	{
		acc = acc + ((arr[0] * 2 + 4) * 3 - 5);
		if (i - ((i / 40) * 40) == 0)
		{
			arr[0] = i + 2;
		}
	}

	printf("%d\n", acc);
	return 0;
}
