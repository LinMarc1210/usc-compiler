; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  switch i32 2, label %switch.end [
    i32 1, label %switch.case
    i32 2, label %switch.case1
    i32 3, label %switch.case2
  ]

switch.end:                                       ; preds = %switch.case2, %switch.case1, %switch.case, %entry
  %Phi = phi i32 [ 30, %switch.case2 ], [ 20, %switch.case1 ], [ 10, %switch.case ], [ 0, %entry ]
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %Phi)
  ret i32 0

switch.case:                                      ; preds = %entry
  br label %switch.end

switch.case1:                                     ; preds = %entry
  br label %switch.end

switch.case2:                                     ; preds = %entry
  br label %switch.end
}
