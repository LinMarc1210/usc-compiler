; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  br label %dowhile.body

dowhile.body:                                     ; preds = %dowhile.cond, %entry
  %Phi = phi i32 [ %sub, %dowhile.cond ], [ 10, %entry ]
  %Phi1 = phi i32 [ %add, %dowhile.cond ], [ 0, %entry ]
  %sub = sub i32 %Phi, 1
  %add = add i32 %Phi1, 1
  br label %dowhile.cond

dowhile.cond:                                     ; preds = %dowhile.body
  %gt = icmp sgt i32 %sub, 0
  br i1 %gt, label %dowhile.body, label %dowhile.end

dowhile.end:                                      ; preds = %dowhile.cond
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %add)
  ret i32 0
}
