; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @foo(i32 %m, i32 %n) {
entry:
  %arr = alloca [5 x i32], align 8
  %0 = getelementptr inbounds [5 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 %m
  store i32 10, i32* %1
  %2 = getelementptr inbounds i32* %0, i32 %n
  store i32 20, i32* %2
  %3 = getelementptr inbounds i32* %0, i32 %m
  %4 = load i32* %3
  %5 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %6 = call i32 (i8*, ...)* @printf(i8* %5, i32 %4)
  ret i32 0
}

define i32 @main() {
entry:
  %call = call i32 @foo(i32 1, i32 3)
  ret i32 0
}
