; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  br label %while.cond

while.cond:                                       ; preds = %if.end, %entry
  %Phi = phi i32 [ %add2, %if.end ], [ 0, %entry ]
  %Phi1 = phi i32 [ %add, %if.end ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 10
  br i1 %lt, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  %add = add i32 %Phi1, %Phi
  %eq = icmp eq i32 %Phi, 5
  br i1 %eq, label %if.then, label %if.end

while.end:                                        ; preds = %if.then, %while.cond
  %Phi3 = phi i32 [ %add, %if.then ], [ %Phi1, %while.cond ]
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %Phi3)
  ret i32 0

if.then:                                          ; preds = %while.body
  br label %while.end

if.end:                                           ; preds = %while.body
  %add2 = add i32 %Phi, 1
  br label %while.cond
}
