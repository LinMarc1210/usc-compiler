; ModuleID = 'main'

@.str = private unnamed_addr constant [7 x i8] c"c: %d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %mul = mul i32 5, 2
  %add = add i32 5, %mul
  %mul1 = mul i32 5, 6
  %0 = getelementptr inbounds [7 x i8]* @.str, i32 0, i32 0
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %mul1)
  ret i32 0
}
