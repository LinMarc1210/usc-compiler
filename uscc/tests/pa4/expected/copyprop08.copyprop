; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [10 x i32], align 8
  %0 = getelementptr inbounds [10 x i32]* %arr, i32 0, i32 0
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %Phi = phi i32 [ %add3, %while.body ], [ 0, %entry ]
  %Phi2 = phi i32 [ %add, %while.body ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 10
  br i1 %lt, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  %1 = getelementptr inbounds i32* %0, i32 %Phi
  store i32 %Phi, i32* %1
  %add = add i32 %Phi2, %Phi
  %add3 = add i32 %Phi, 1
  br label %while.cond

while.end:                                        ; preds = %while.cond
  %2 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %3 = call i32 (i8*, ...)* @printf(i8* %2, i32 %Phi2)
  ret i32 0
}
