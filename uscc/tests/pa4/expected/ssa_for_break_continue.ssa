; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  br label %for.cond

for.cond:                                         ; preds = %for.step, %entry
  %Phi = phi i32 [ %add6, %for.step ], [ 0, %entry ]
  %Phi4 = phi i32 [ %Phi7, %for.step ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 10
  br i1 %lt, label %for.body, label %for.end

for.body:                                         ; preds = %for.cond
  %eq = icmp eq i32 %Phi, 3
  br i1 %eq, label %if.then, label %if.end

for.step:                                         ; preds = %if.end3, %if.then
  %Phi7 = phi i32 [ %add, %if.end3 ], [ %Phi4, %if.then ]
  %add6 = add i32 %Phi, 1
  br label %for.cond

for.end:                                          ; preds = %if.then2, %for.cond
  %0 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i32 %Phi4)
  ret i32 0

if.then:                                          ; preds = %for.body
  br label %for.step

if.end:                                           ; preds = %for.body
  %eq1 = icmp eq i32 %Phi, 7
  br i1 %eq1, label %if.then2, label %if.end3

if.then2:                                         ; preds = %if.end
  br label %for.end

if.end3:                                          ; preds = %if.end
  %add = add i32 %Phi4, %Phi
  br label %for.step
}
