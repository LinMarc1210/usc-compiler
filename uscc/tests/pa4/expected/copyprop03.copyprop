; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %arr = alloca [3 x i32], align 8
  %0 = getelementptr inbounds [3 x i32]* %arr, i32 0, i32 0
  %1 = getelementptr inbounds i32* %0, i32 0
  store i32 5, i32* %1
  %add = add i32 5, 1
  %2 = getelementptr inbounds i32* %0, i32 1
  store i32 %add, i32* %2
  %3 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %4 = call i32 (i8*, ...)* @printf(i8* %3, i32 %add)
  ret i32 0
}
