; ModuleID = 'main'

@.str = private unnamed_addr constant [4 x i8] c"%c\0A\00"
@.str1 = private unnamed_addr constant [4 x i8] c"%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  %conv = trunc i32 97 to i8
  %conv1 = sext i8 %conv to i32
  %0 = getelementptr inbounds [4 x i8]* @.str1, i32 0, i32 0
  %conv2 = sext i8 %conv to i32
  %eq = icmp eq i32 97, %conv2
  %1 = call i32 (i8*, ...)* @printf(i8* %0, i1 %eq)
  %2 = getelementptr inbounds [4 x i8]* @.str1, i32 0, i32 0
  %3 = call i32 (i8*, ...)* @printf(i8* %2, i32 %conv1)
  %4 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %inc = add i8 %conv, 1
  %conv3 = sext i8 %inc to i32
  %5 = call i32 (i8*, ...)* @printf(i8* %4, i32 %conv3)
  %6 = getelementptr inbounds [4 x i8]* @.str, i32 0, i32 0
  %dec = sub i8 %inc, 1
  %conv4 = sext i8 %dec to i32
  %7 = call i32 (i8*, ...)* @printf(i8* %6, i32 %conv4)
  ret i32 0
}
