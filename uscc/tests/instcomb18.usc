// instcomb18.usc
// Comprehensive: Part 1 + Part 2
// Tests: Constant folding combined with identity patterns
// Expected: All optimizations applied
//---------------------------------------------------------

int compute(int x)
{
	int a = 10 + 5;
	int b = x + 0;
	int c = x * 1;
	int d = x * 8;
	return a + b + c + d;
}

int main()
{
	printf("%d\n", compute(3));
	return 0;
}
