// edgeprof15.usc
// Pattern: Bubble Sort Simulation
// Tests O(n^2) operations with comparisons and swaps
// ~22 edges, n=5000, ~12.5M comparisons
//---------------------------------------------------------

int main()
{
    int n = 5000;
    int i = 0;
    int j = 0;
    int swaps = 0;
    int comparisons = 0;
    int val = 0;
    int left = 0;
    int right = 0;

    while (i < n)
    {
        j = 0;
        while (j < n - i - 1)
        {
            comparisons = comparisons + 1;

            // Simulate comparison based on position
            left = (n - j) % 10;
            right = (n - j - 1) % 10;

            if (left > right)
            {
                // Simulate swap
                swaps = swaps + 1;
            }

            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
